* text=auto

# Repository text contract: LF in tracked cross-platform text.
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
*.json text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Windows-native shell scripts remain CRLF by explicit exception.
*.ps1 text eol=crlf
