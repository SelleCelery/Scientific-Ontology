{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-ontology.local/schemas/docs_registration_review.schema.json",
  "title": "Scientific Ontology registration review transaction",
  "type": "object",
  "required": ["registration_review"],
  "additionalProperties": false,
  "properties": {
    "registration_review": {
      "type": "object",
      "required": ["schema_version", "status", "source", "decisions", "manual_candidates", "revision_candidates"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "0.3"},
        "status": {"enum": ["in_progress", "complete"]},
        "exported_at": {"type": "string"},
        "source": {
          "type": "object",
          "required": ["manifest_sha256", "graph_sha256", "provisional_count", "revision_proposals_sha256", "revision_proposal_count"],
          "additionalProperties": false,
          "properties": {
            "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "provisional_count": {"type": "integer", "minimum": 0},
            "revision_proposals_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "revision_proposal_count": {"type": "integer", "minimum": 0}
          }
        },
        "summary": {"type": "object"},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
        "manual_candidates": {"type": "array", "items": {"$ref": "#/$defs/manualCandidate"}},
        "revision_candidates": {"type": "array", "items": {"$ref": "#/$defs/revisionCandidate"}}
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["path", "doc_id", "decision", "reviewed_at", "before", "after"],
      "additionalProperties": true,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "doc_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["approve", "approve_with_edits", "hold", "reject"]},
        "reviewed_at": {"type": "string"},
        "reviewer_note": {"type": "string"},
        "before": {"type": "object"},
        "after": {"type": "object"}
      }
    },
    "manualCandidate": {
      "type": "object",
      "required": ["id", "created_at", "decision", "proposed"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string"},
        "reviewer_note": {"type": "string"},
        "decision": {"enum": ["approve", "hold", "reject"]},
        "proposed": {"type": "object"}
      }
    },
    "revisionCandidate": {
      "type": "object",
      "required": ["doc_id", "path", "created_at", "decision", "source_kind", "before", "after"],
      "additionalProperties": true,
      "properties": {
        "doc_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "created_at": {"type": "string"},
        "reviewer_note": {"type": "string"},
        "decision": {"enum": ["approve", "hold", "reject"]},
        "source_kind": {"enum": ["revision_proposal", "ad_hoc_registered_revision"]},
        "proposal_id": {"type": "string"},
        "proposal_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "before": {"type": "object"},
        "after": {"type": "object"}
      }
    }
  }
}
