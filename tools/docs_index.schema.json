{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scientific-ontology/docs-index.schema.json",
  "title": "Scientific Ontology document navigation index",
  "type": "object",
  "required": [
    "schema_version",
    "search_spec_version",
    "source",
    "search_profile",
    "topics",
    "query_expansions",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "search_spec_version": {
      "const": "0.2"
    },
    "source": {
      "type": "object",
      "required": [
        "manifest_sha256",
        "search_config_sha256",
        "coverage",
        "visibility_profile"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "search_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage": {
          "type": "string"
        },
        "visibility_profile": {
          "enum": [
            "preview",
            "public"
          ]
        }
      },
      "additionalProperties": false
    },
    "search_profile": {
      "type": "object"
    },
    "topics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/topic"
      }
    },
    "query_expansions": {
      "type": "object"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "search_value": {
      "type": "object",
      "required": [
        "lang",
        "text",
        "normalized",
        "compact"
      ],
      "properties": {
        "lang": {
          "enum": [
            "ja",
            "en",
            "und"
          ]
        },
        "text": {
          "type": "string"
        },
        "normalized": {
          "type": "string"
        },
        "compact": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "id_source",
        "path",
        "title",
        "layer",
        "document_type",
        "status",
        "state",
        "registration_state",
        "scope",
        "role",
        "discovery",
        "concepts",
        "relations",
        "search_fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "id_source": {
          "enum": [
            "explicit",
            "fallback"
          ]
        },
        "path": {
          "type": "string"
        },
        "title": {
          "type": "object"
        },
        "layer": {
          "type": "string"
        },
        "document_type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "registration_state": {
          "enum": ["registered", "provisional"]
        },
        "scope": {
          "type": "string"
        },
        "role": {
          "type": "object"
        },
        "language_relation": {},
        "discovery": {
          "type": "object"
        },
        "concepts": {
          "type": "object"
        },
        "relations": {
          "type": "object"
        },
        "search_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/search_value"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "localized_string": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "localized_string_array": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "properties": {
        "ja": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "browse_topic": {
      "type": "object",
      "required": [
        "enabled",
        "order",
        "label",
        "description",
        "starter_questions"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "order": {
          "type": "integer"
        },
        "label": {
          "$ref": "#/$defs/localized_string"
        },
        "description": {
          "$ref": "#/$defs/localized_string"
        },
        "starter_questions": {
          "$ref": "#/$defs/localized_string_array"
        }
      },
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "browse": {
          "$ref": "#/$defs/browse_topic"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
