{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientific-ontology.local/schemas/repository_assessment_protocols.schema.json",
  "title": "Scientific Ontology repository assessment protocols",
  "type": "object",
  "required": ["repository_assessment_protocols"],
  "properties": {
    "repository_assessment_protocols": {
      "type": "object",
      "required": ["schema_version", "status", "protocols"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "status": {"type": "string"},
        "protocols": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "revision", "state", "default_targets", "execution_principles", "strength_scale", "exposure_scale", "output_contract", "review_policy"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1},
              "state": {"type": "string", "minLength": 1},
              "default_targets": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "execution_principles": {"type": "array", "minItems": 1},
              "strength_scale": {"type": "object"},
              "exposure_scale": {"type": "object"},
              "output_contract": {"type": "object"},
              "review_policy": {"type": "object"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
