訳</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L13:C0" target="t:翻訳" id="e25"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:通約"><data key="node_type">term_candidate</data><data key="display">通約</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L13:C0" target="t:通約" id="e26"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:用語衝突管理"><data key="node_type">term_candidate</data><data key="display">用語衝突管理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L13:C0" target="t:用語衝突管理" id="e27"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:一般方針"><data key="node_type">term_candidate</data><data key="display">一般方針</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L13:C0" target="t:一般方針" id="e28"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:用語衝突管理表"><data key="node_type">term_candidate</data><data key="display">用語衝突管理表</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L13:C0" target="t:用語衝突管理表" id="e29"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:参照"><data key="node_type">term_candidate</data><data key="display">参照</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L13:C0" target="t:参照" id="e30"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:0.1:C4"><data key="node_type">sentence</data><data key="display">本稿は、知を、主体内部の認識形式にも、外部事実への単純対応にも還元しない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L19:C4</data><data key="split">register</data></node><edge source="s:SAT:0.1:C4" target="t:本稿" id="e31"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.1:C4" target="t:知" id="e32"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:主体内部"><data key="node_type">term_candidate</data><data key="display">主体内部</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.1:C4" target="t:主体内部" id="e33"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:認識形式"><data key="node_type">term_candidate</data><data key="display">認識形式</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.1:C4" target="t:認識形式" id="e34"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外部事実"><data key="node_type">term_candidate</data><data key="display">外部事実</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.1:C4" target="t:外部事実" id="e35"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:単純対応"><data key="node_type">term_candidate</data><data key="display">単純対応</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.1:C4" target="t:単純対応" id="e36"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:還元"><data key="node_type">term_candidate</data><data key="display">還元</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.1:C4" target="t:還元" id="e37"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:0.2:C4"><data key="node_type">sentence</data><data key="display">知とは、履歴を持つ存在が、外部からの入力を受け取り、内部で処理し、外部と同期し、その一致・不一致・残差を照合し、なお閉じきれないものを保持しながら、次の判断可能性を維持することで成立する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L21:C4</data><data key="split">tune</data></node><edge source="s:SAT:0.2:C4" target="t:知" id="e38"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.2:C4" target="t:履歴" id="e39"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:存在"><data key="node_type">term_candidate</data><data key="display">存在</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:存在" id="e40"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.2:C4" target="t:外部" id="e41"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:入力"><data key="node_type">term_candidate</data><data key="display">入力</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:入力" id="e42"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.2:C4" target="t:内部" id="e43"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:処理"><data key="node_type">term_candidate</data><data key="display">処理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:処理" id="e44"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.2:C4" target="t:同期" id="e45"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:一致"><data key="node_type">term_candidate</data><data key="display">一致</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:一致" id="e46"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:不一致"><data key="node_type">term_candidate</data><data key="display">不一致</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:不一致" id="e47"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:残差"><data key="node_type">term_candidate</data><data key="display">残差</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:残差" id="e48"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.2:C4" target="t:照合" id="e49"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:保持"><data key="node_type">term_candidate</data><data key="display">保持</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:保持" id="e50"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:判断可能性"><data key="node_type">term_candidate</data><data key="display">判断可能性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:判断可能性" id="e51"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:維持"><data key="node_type">term_candidate</data><data key="display">維持</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:維持" id="e52"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:成立"><data key="node_type">term_candidate</data><data key="display">成立</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="t:成立" id="e53"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:とは"><data key="node_type">expression_candidate</data><data key="display">とは</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="f:とは" id="e54"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:しながら"><data key="node_type">expression_candidate</data><data key="display">しながら</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="f:しながら" id="e55"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:成立する"><data key="node_type">expression_candidate</data><data key="display">成立する</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2:C4" target="f:成立する" id="e56"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:0.2.1:C6"><data key="node_type">sentence</data><data key="display">したがって、認識とは「世界をそのまま写すこと」ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L23:C6</data><data key="split">register</data></node><node id="t:認識"><data key="node_type">term_candidate</data><data key="display">認識</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2.1:C6" target="t:認識" id="e57"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:世界"><data key="node_type">term_candidate</data><data key="display">世界</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2.1:C6" target="t:世界" id="e58"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:したがって"><data key="node_type">expression_candidate</data><data key="display">したがって</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2.1:C6" target="f:したがって" id="e59"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:0.2.1:C6" target="f:とは" id="e60"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:0.2.1:C6" target="f:ではない" id="e61"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:0.2.2:C6"><data key="node_type">sentence</data><data key="display">また、認識とは「主体が勝手に構成すること」でもない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L25:C6</data><data key="split">register</data></node><edge source="s:SAT:0.2.2:C6" target="t:認識" id="e62"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:主体"><data key="node_type">term_candidate</data><data key="display">主体</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2.2:C6" target="t:主体" id="e63"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:勝手"><data key="node_type">term_candidate</data><data key="display">勝手</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2.2:C6" target="t:勝手" id="e64"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:構成"><data key="node_type">term_candidate</data><data key="display">構成</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.2.2:C6" target="t:構成" id="e65"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.2.2:C6" target="f:とは" id="e66"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:0.3:C4"><data key="node_type">sentence</data><data key="display">認識とは、境界において、内部ヒューリスティックと外部ヒューリスティックが接触し、同期し、照合され、残差を残しながら更新される過程である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L27:C4</data><data key="split">tune</data></node><edge source="s:SAT:0.3:C4" target="t:認識" id="e67"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="t:境界" id="e68"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="t:内部" id="e69"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="t:ヒューリスティック" id="e70"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="t:外部" id="e71"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:接触"><data key="node_type">term_candidate</data><data key="display">接触</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3:C4" target="t:接触" id="e72"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="t:同期" id="e73"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="t:照合" id="e74"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="t:残差" id="e75"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:更新"><data key="node_type">term_candidate</data><data key="display">更新</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3:C4" target="t:更新" id="e76"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:過程"><data key="node_type">term_candidate</data><data key="display">過程</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3:C4" target="t:過程" id="e77"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="f:とは" id="e78"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:において"><data key="node_type">expression_candidate</data><data key="display">において</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3:C4" target="f:において" id="e79"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="f:しながら" id="e80"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:0.3:C4" target="f:である" id="e81"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:0.3.1:C6"><data key="node_type">sentence</data><data key="display">本稿は、この過程の成立条件・適用範囲・失敗条件を問う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L29:C6</data><data key="split">register</data></node><edge source="s:SAT:0.3.1:C6" target="t:本稿" id="e82"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.1:C6" target="t:過程" id="e83"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.1:C6" target="t:成立条件" id="e84"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:適用範囲"><data key="node_type">term_candidate</data><data key="display">適用範囲</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.1:C6" target="t:適用範囲" id="e85"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:失敗条件"><data key="node_type">term_candidate</data><data key="display">失敗条件</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.1:C6" target="t:失敗条件" id="e86"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:問う"><data key="node_type">expression_candidate</data><data key="display">問う</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.1:C6" target="f:問う" id="e87"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:0.3.1.1:C8"><data key="node_type">sentence</data><data key="display">この意味で、本稿は境界認識批判である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L31:C8</data><data key="split">register</data></node><node id="t:意味"><data key="node_type">term_candidate</data><data key="display">意味</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.1.1:C8" target="t:意味" id="e88"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.1.1:C8" target="t:本稿" id="e89"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:境界認識批判"><data key="node_type">term_candidate</data><data key="display">境界認識批判</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.1.1:C8" target="t:境界認識批判" id="e90"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.1.1:C8" target="f:である" id="e91"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:0.3.2:C6"><data key="node_type">sentence</data><data key="display">境界認識批判は、すべてを観測可能にするための観測理論ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L33:C6</data><data key="split">register</data></node><edge source="s:SAT:0.3.2:C6" target="t:境界認識批判" id="e92"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:観測可能"><data key="node_type">term_candidate</data><data key="display">観測可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.2:C6" target="t:観測可能" id="e93"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:観測理論"><data key="node_type">term_candidate</data><data key="display">観測理論</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.2:C6" target="t:観測理論" id="e94"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.2:C6" target="f:ではない" id="e95"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:0.3.3:C6"><data key="node_type">sentence</data><data key="display">境界認識批判は、有限観測系において、観測・分類・同期・照合から漏れるものを、どのように残差として保持し、再照合可能性を維持するかを問う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L35:C6</data><data key="split">register</data></node><edge source="s:SAT:0.3.3:C6" target="t:境界認識批判" id="e96"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:有限観測系"><data key="node_type">term_candidate</data><data key="display">有限観測系</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.3:C6" target="t:有限観測系" id="e97"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:観測"><data key="node_type">term_candidate</data><data key="display">観測</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.3:C6" target="t:観測" id="e98"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分類"><data key="node_type">term_candidate</data><data key="display">分類</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.3:C6" target="t:分類" id="e99"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.3:C6" target="t:同期" id="e100"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.3:C6" target="t:照合" id="e101"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.3:C6" target="t:残差" id="e102"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.3:C6" target="t:保持" id="e103"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.3:C6" target="t:再照合可能性" id="e104"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.3:C6" target="t:維持" id="e105"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:0.3.3:C6" target="f:において" id="e106"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:として"><data key="node_type">expression_candidate</data><data key="display">として</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:0.3.3:C6" target="f:として" id="e107"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:0.3.3:C6" target="f:問う" id="e108"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.1:C4"><data key="node_type">sentence</data><data key="display">存在は、単なる物ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L41:C4</data><data key="split">register</data></node><edge source="s:SAT:1.1:C4" target="t:存在" id="e109"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.1:C4" target="f:ではない" id="e110"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.2:C4"><data key="node_type">sentence</data><data key="display">存在は、履歴を持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L43:C4</data><data key="split">tune</data></node><edge source="s:SAT:1.2:C4" target="t:存在" id="e111"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.2:C4" target="t:履歴" id="e112"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:1.2.1:C6"><data key="node_type">sentence</data><data key="display">履歴とは、単なる過去ではなく、次の受け取り方・反応・判断・意味づけを変えるものである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L45:C6</data><data key="split">tune</data></node><edge source="s:SAT:1.2.1:C6" target="t:履歴" id="e113"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:過去"><data key="node_type">term_candidate</data><data key="display">過去</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.2.1:C6" target="t:過去" id="e114"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:反応"><data key="node_type">term_candidate</data><data key="display">反応</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.2.1:C6" target="t:反応" id="e115"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:判断"><data key="node_type">term_candidate</data><data key="display">判断</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.2.1:C6" target="t:判断" id="e116"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.2.1:C6" target="t:意味" id="e117"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.2.1:C6" target="f:とは" id="e118"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:1.2.1:C6" target="f:である" id="e119"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.3:C4"><data key="node_type">sentence</data><data key="display">存在は、履歴を持つ場として、外部と接触する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L47:C4</data><data key="split">register</data></node><edge source="s:SAT:1.3:C4" target="t:存在" id="e120"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.3:C4" target="t:履歴" id="e121"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.3:C4" target="t:外部" id="e122"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.3:C4" target="t:接触" id="e123"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.3:C4" target="f:として" id="e124"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.4:C4"><data key="node_type">sentence</data><data key="display">接触は、境界において起こる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L49:C4</data><data key="split">test</data></node><edge source="s:SAT:1.4:C4" target="t:接触" id="e125"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.4:C4" target="t:境界" id="e126"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.4:C4" target="f:において" id="e127"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.4.1:C6"><data key="node_type">sentence</data><data key="display">境界は、防壁ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L51:C6</data><data key="split">register</data></node><edge source="s:SAT:1.4.1:C6" target="t:境界" id="e128"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:防壁"><data key="node_type">term_candidate</data><data key="display">防壁</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.4.1:C6" target="t:防壁" id="e129"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.4.1:C6" target="f:ではない" id="e130"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.4.2:C6"><data key="node_type">sentence</data><data key="display">境界は、外部入力と内部履歴が接触し、通過・保留・遮断・再符号化・反射・更新される面である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L53:C6</data><data key="split">tune</data></node><edge source="s:SAT:1.4.2:C6" target="t:境界" id="e131"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外部入力"><data key="node_type">term_candidate</data><data key="display">外部入力</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.4.2:C6" target="t:外部入力" id="e132"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:内部履歴"><data key="node_type">term_candidate</data><data key="display">内部履歴</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.4.2:C6" target="t:内部履歴" id="e133"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.4.2:C6" target="t:接触" id="e134"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:通過"><data key="node_type">term_candidate</data><data key="display">通過</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.4.2:C6" target="t:通過" id="e135"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:保留"><data key="node_type">term_candidate</data><data key="display">保留</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.4.2:C6" target="t:保留" id="e136"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:遮断"><data key="node_type">term_candidate</data><data key="display">遮断</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.4.2:C6" target="t:遮断" id="e137"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:再符号化"><data key="node_type">term_candidate</data><data key="display">再符号化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.4.2:C6" target="t:再符号化" id="e138"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:反射"><data key="node_type">term_candidate</data><data key="display">反射</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.4.2:C6" target="t:反射" id="e139"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.4.2:C6" target="t:更新" id="e140"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.4.2:C6" target="f:である" id="e141"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.5:C4"><data key="node_type">sentence</data><data key="display">したがって、認識は境界なしには成立しない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L55:C4</data><data key="split">register</data></node><edge source="s:SAT:1.5:C4" target="t:認識" id="e142"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5:C4" target="t:境界" id="e143"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5:C4" target="t:成立" id="e144"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5:C4" target="f:したがって" id="e145"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.5.1:C6"><data key="node_type">sentence</data><data key="display">境界のない認識は、外部に呑まれる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L57:C6</data><data key="split">test</data></node><edge source="s:SAT:1.5.1:C6" target="t:境界" id="e146"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.1:C6" target="t:認識" id="e147"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.1:C6" target="t:外部" id="e148"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:1.5.2:C6"><data key="node_type">sentence</data><data key="display">境界の弱すぎる認識は、外部入力と内部履歴を区別できない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L59:C6</data><data key="split">register</data></node><edge source="s:SAT:1.5.2:C6" target="t:境界" id="e149"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.2:C6" target="t:認識" id="e150"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.2:C6" target="t:外部入力" id="e151"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.2:C6" target="t:内部履歴" id="e152"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:区別"><data key="node_type">term_candidate</data><data key="display">区別</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.5.2:C6" target="t:区別" id="e153"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:できない"><data key="node_type">expression_candidate</data><data key="display">できない</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.5.2:C6" target="f:できない" id="e154"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:1.5.3:C6"><data key="node_type">sentence</data><data key="display">境界の強すぎる認識は、外部からの更新を拒み、内部ヒューリスティックを教義化する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L61:C6</data><data key="split">register</data></node><edge source="s:SAT:1.5.3:C6" target="t:境界" id="e155"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.3:C6" target="t:認識" id="e156"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.3:C6" target="t:外部" id="e157"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.3:C6" target="t:更新" id="e158"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.3:C6" target="t:内部" id="e159"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.3:C6" target="t:ヒューリスティック" id="e160"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:教義化"><data key="node_type">term_candidate</data><data key="display">教義化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.5.3:C6" target="t:教義化" id="e161"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:1.5.4:C6"><data key="node_type">sentence</data><data key="display">境界の硬すぎる認識は、内部に閉じる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L63:C6</data><data key="split">tune</data></node><edge source="s:SAT:1.5.4:C6" target="t:境界" id="e162"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.4:C6" target="t:認識" id="e163"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.5.4:C6" target="t:内部" id="e164"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:1.6:C4"><data key="node_type">sentence</data><data key="display">境界認識批判は、境界を消すのではなく、境界の位置・硬さ・開閉・残差保持条件を問う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L65:C4</data><data key="split">register</data></node><edge source="s:SAT:1.6:C4" target="t:境界認識批判" id="e165"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.6:C4" target="t:境界" id="e166"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:位置"><data key="node_type">term_candidate</data><data key="display">位置</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.6:C4" target="t:位置" id="e167"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:開閉"><data key="node_type">term_candidate</data><data key="display">開閉</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.6:C4" target="t:開閉" id="e168"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:残差保持条件"><data key="node_type">term_candidate</data><data key="display">残差保持条件</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:1.6:C4" target="t:残差保持条件" id="e169"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:1.6:C4" target="f:問う" id="e170"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.1:C4"><data key="node_type">sentence</data><data key="display">感性とは、外部入力が履歴場に到達したとき、何が信号として立ち上がるかを決める受容構造である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L71:C4</data><data key="split">test</data></node><node id="t:感性"><data key="node_type">term_candidate</data><data key="display">感性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.1:C4" target="t:感性" id="e171"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.1:C4" target="t:外部入力" id="e172"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:履歴場"><data key="node_type">term_candidate</data><data key="display">履歴場</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.1:C4" target="t:履歴場" id="e173"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:到達"><data key="node_type">term_candidate</data><data key="display">到達</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.1:C4" target="t:到達" id="e174"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:信号"><data key="node_type">term_candidate</data><data key="display">信号</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.1:C4" target="t:信号" id="e175"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:受容構造"><data key="node_type">term_candidate</data><data key="display">受容構造</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.1:C4" target="t:受容構造" id="e176"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.1:C4" target="f:とは" id="e177"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:とき"><data key="node_type">expression_candidate</data><data key="display">とき</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.1:C4" target="f:とき" id="e178"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:2.1:C4" target="f:として" id="e179"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:2.1:C4" target="f:である" id="e180"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.2:C4"><data key="node_type">sentence</data><data key="display">何が見えるかは、履歴によって変わる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L73:C4</data><data key="split">register</data></node><edge source="s:SAT:2.2:C4" target="t:履歴" id="e181"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:によって"><data key="node_type">expression_candidate</data><data key="display">によって</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.2:C4" target="f:によって" id="e182"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.3:C4"><data key="node_type">sentence</data><data key="display">何が聞こえるかも、履歴によって変わる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L75:C4</data><data key="split">register</data></node><edge source="s:SAT:2.3:C4" target="t:履歴" id="e183"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.3:C4" target="f:によって" id="e184"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.4:C4"><data key="node_type">sentence</data><data key="display">何が違和感として残るかも、履歴によって変わる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L77:C4</data><data key="split">register</data></node><node id="t:違和感"><data key="node_type">term_candidate</data><data key="display">違和感</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.4:C4" target="t:違和感" id="e185"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.4:C4" target="t:履歴" id="e186"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.4:C4" target="f:として" id="e187"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:2.4:C4" target="f:によって" id="e188"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.5:C4"><data key="node_type">sentence</data><data key="display">したがって、感性は単なる受動的な器ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L79:C4</data><data key="split">tune</data></node><edge source="s:SAT:2.5:C4" target="t:感性" id="e189"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:受動的"><data key="node_type">term_candidate</data><data key="display">受動的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.5:C4" target="t:受動的" id="e190"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.5:C4" target="f:したがって" id="e191"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:2.5:C4" target="f:ではない" id="e192"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.6:C4"><data key="node_type">sentence</data><data key="display">感性は、履歴に準拠した受容ヒューリスティックである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L81:C4</data><data key="split">register</data></node><edge source="s:SAT:2.6:C4" target="t:感性" id="e193"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.6:C4" target="t:履歴" id="e194"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:準拠"><data key="node_type">term_candidate</data><data key="display">準拠</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.6:C4" target="t:準拠" id="e195"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:受容"><data key="node_type">term_candidate</data><data key="display">受容</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.6:C4" target="t:受容" id="e196"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.6:C4" target="t:ヒューリスティック" id="e197"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.6:C4" target="f:である" id="e198"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.6.1:C6"><data key="node_type">sentence</data><data key="display">感性は、外部入力をそのまま受け取るのではなく、内部履歴に応じて受け取り可能な形へ切り出す。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L83:C6</data><data key="split">register</data></node><edge source="s:SAT:2.6.1:C6" target="t:感性" id="e199"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.6.1:C6" target="t:外部入力" id="e200"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.6.1:C6" target="t:内部履歴" id="e201"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:可能"><data key="node_type">term_candidate</data><data key="display">可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.6.1:C6" target="t:可能" id="e202"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:2.6.1.1:C8"><data key="node_type">sentence</data><data key="display">ここで切り出されたものが、経験の素材となる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L85:C8</data><data key="split">tune</data></node><node id="t:経験"><data key="node_type">term_candidate</data><data key="display">経験</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.6.1.1:C8" target="t:経験" id="e203"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:素材"><data key="node_type">term_candidate</data><data key="display">素材</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.6.1.1:C8" target="t:素材" id="e204"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:2.6.1.2:C8"><data key="node_type">sentence</data><data key="display">しかし、切り出されなかったものは消えたわけではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L87:C8</data><data key="split">register</data></node><node id="f:しかし"><data key="node_type">expression_candidate</data><data key="display">しかし</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.6.1.2:C8" target="f:しかし" id="e205"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:2.6.1.2:C8" target="f:ではない" id="e206"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.6.1.3:C8"><data key="node_type">sentence</data><data key="display">それはノイズ、違和感、残差、未処理履歴として残ることがある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L89:C8</data><data key="split">register</data></node><node id="t:ノイズ"><data key="node_type">term_candidate</data><data key="display">ノイズ</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.6.1.3:C8" target="t:ノイズ" id="e207"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.6.1.3:C8" target="t:違和感" id="e208"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.6.1.3:C8" target="t:残差" id="e209"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未処理履歴"><data key="node_type">term_candidate</data><data key="display">未処理履歴</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.6.1.3:C8" target="t:未処理履歴" id="e210"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.6.1.3:C8" target="f:として" id="e211"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.7:C4"><data key="node_type">sentence</data><data key="display">感性の研究は、何が現れるかだけでは足りない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L91:C4</data><data key="split">register</data></node><edge source="s:SAT:2.7:C4" target="t:感性" id="e212"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:研究"><data key="node_type">term_candidate</data><data key="display">研究</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.7:C4" target="t:研究" id="e213"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:2.8:C4"><data key="node_type">sentence</data><data key="display">感性の研究は、何が現れないまま作用するかを問わなければならない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L93:C4</data><data key="split">test</data></node><edge source="s:SAT:2.8:C4" target="t:感性" id="e214"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.8:C4" target="t:研究" id="e215"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:作用"><data key="node_type">term_candidate</data><data key="display">作用</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.8:C4" target="t:作用" id="e216"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:2.9:C4"><data key="node_type">sentence</data><data key="display">感性の失敗は、受け取れないものを存在しないものと誤認することである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L95:C4</data><data key="split">test</data></node><edge source="s:SAT:2.9:C4" target="t:感性" id="e217"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:失敗"><data key="node_type">term_candidate</data><data key="display">失敗</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.9:C4" target="t:失敗" id="e218"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.9:C4" target="t:存在" id="e219"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:誤認"><data key="node_type">term_candidate</data><data key="display">誤認</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.9:C4" target="t:誤認" id="e220"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.9:C4" target="f:である" id="e221"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:2.10:C5"><data key="node_type">sentence</data><data key="display">感性の過剰は、すべてのノイズを意味として受け取り、境界を過熱させることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L97:C5</data><data key="split">register</data></node><edge source="s:SAT:2.10:C5" target="t:感性" id="e222"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:過剰"><data key="node_type">term_candidate</data><data key="display">過剰</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.10:C5" target="t:過剰" id="e223"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.10:C5" target="t:ノイズ" id="e224"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.10:C5" target="t:意味" id="e225"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.10:C5" target="t:境界" id="e226"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:過熱"><data key="node_type">term_candidate</data><data key="display">過熱</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:2.10:C5" target="t:過熱" id="e227"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:2.10:C5" target="f:として" id="e228"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:2.10:C5" target="f:である" id="e229"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.1:C4"><data key="node_type">sentence</data><data key="display">悟性とは、入力を判断可能な対象へ変換する分類構造である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L103:C4</data><data key="split">register</data></node><node id="t:悟性"><data key="node_type">term_candidate</data><data key="display">悟性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.1:C4" target="t:悟性" id="e230"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.1:C4" target="t:入力" id="e231"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:判断可能"><data key="node_type">term_candidate</data><data key="display">判断可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.1:C4" target="t:判断可能" id="e232"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:対象"><data key="node_type">term_candidate</data><data key="display">対象</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.1:C4" target="t:対象" id="e233"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:変換"><data key="node_type">term_candidate</data><data key="display">変換</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.1:C4" target="t:変換" id="e234"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分類構造"><data key="node_type">term_candidate</data><data key="display">分類構造</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.1:C4" target="t:分類構造" id="e235"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.1:C4" target="f:とは" id="e236"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:3.1:C4" target="f:である" id="e237"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.2:C4"><data key="node_type">sentence</data><data key="display">分類とは、単なる名前づけではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L105:C4</data><data key="split">test</data></node><edge source="s:SAT:3.2:C4" target="t:分類" id="e238"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:名前"><data key="node_type">term_candidate</data><data key="display">名前</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.2:C4" target="t:名前" id="e239"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.2:C4" target="f:とは" id="e240"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:3.2:C4" target="f:ではない" id="e241"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.3:C4"><data key="node_type">sentence</data><data key="display">分類は、何を対象とし、何を背景とし、何を関係とし、何を原因とし、何を責任とし、何を価値とするかを決める。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L107:C4</data><data key="split">register</data></node><edge source="s:SAT:3.3:C4" target="t:分類" id="e242"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.3:C4" target="t:対象" id="e243"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:背景"><data key="node_type">term_candidate</data><data key="display">背景</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.3:C4" target="t:背景" id="e244"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:関係"><data key="node_type">term_candidate</data><data key="display">関係</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.3:C4" target="t:関係" id="e245"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:原因"><data key="node_type">term_candidate</data><data key="display">原因</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.3:C4" target="t:原因" id="e246"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:責任"><data key="node_type">term_candidate</data><data key="display">責任</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.3:C4" target="t:責任" id="e247"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:価値"><data key="node_type">term_candidate</data><data key="display">価値</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.3:C4" target="t:価値" id="e248"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:とする"><data key="node_type">expression_candidate</data><data key="display">とする</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.3:C4" target="f:とする" id="e249"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.4:C4"><data key="node_type">sentence</data><data key="display">分類の仕方は、履歴構造に依存する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L109:C4</data><data key="split">register</data></node><edge source="s:SAT:3.4:C4" target="t:分類" id="e250"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:仕方"><data key="node_type">term_candidate</data><data key="display">仕方</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.4:C4" target="t:仕方" id="e251"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:履歴構造"><data key="node_type">term_candidate</data><data key="display">履歴構造</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.4:C4" target="t:履歴構造" id="e252"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:依存"><data key="node_type">term_candidate</data><data key="display">依存</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.4:C4" target="t:依存" id="e253"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:3.4.1:C6"><data key="node_type">sentence</data><data key="display">同じ入力でも、異なる履歴場では異なる対象として成立する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L111:C6</data><data key="split">test</data></node><edge source="s:SAT:3.4.1:C6" target="t:入力" id="e254"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.4.1:C6" target="t:履歴場" id="e255"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.4.1:C6" target="t:対象" id="e256"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.4.1:C6" target="t:成立" id="e257"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.4.1:C6" target="f:として" id="e258"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:3.4.1:C6" target="f:成立する" id="e259"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.4.2:C6"><data key="node_type">sentence</data><data key="display">したがって、カテゴリーは固定された表ではなく、履歴場が外部同期のために用いる分類演算子として再構成される。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L113:C6</data><data key="split">register</data></node><node id="t:カテゴリー"><data key="node_type">term_candidate</data><data key="display">カテゴリー</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.4.2:C6" target="t:カテゴリー" id="e260"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:固定"><data key="node_type">term_candidate</data><data key="display">固定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.4.2:C6" target="t:固定" id="e261"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.4.2:C6" target="t:履歴場" id="e262"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外部同期"><data key="node_type">term_candidate</data><data key="display">外部同期</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.4.2:C6" target="t:外部同期" id="e263"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分類演算子"><data key="node_type">term_candidate</data><data key="display">分類演算子</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.4.2:C6" target="t:分類演算子" id="e264"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:再構成"><data key="node_type">term_candidate</data><data key="display">再構成</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.4.2:C6" target="t:再構成" id="e265"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.4.2:C6" target="f:したがって" id="e266"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:3.4.2:C6" target="f:として" id="e267"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.5:C4"><data key="node_type">sentence</data><data key="display">悟性は、感性によって切り出された入力を、判断可能な構造へ変換する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L115:C4</data><data key="split">register</data></node><edge source="s:SAT:3.5:C4" target="t:悟性" id="e268"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5:C4" target="t:感性" id="e269"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5:C4" target="t:入力" id="e270"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5:C4" target="t:判断可能" id="e271"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:構造"><data key="node_type">term_candidate</data><data key="display">構造</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.5:C4" target="t:構造" id="e272"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5:C4" target="t:変換" id="e273"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5:C4" target="f:によって" id="e274"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.5.1:C6"><data key="node_type">sentence</data><data key="display">ただし、悟性は万能ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L117:C6</data><data key="split">register</data></node><edge source="s:SAT:3.5.1:C6" target="t:悟性" id="e275"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:万能"><data key="node_type">term_candidate</data><data key="display">万能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.5.1:C6" target="t:万能" id="e276"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:ただし"><data key="node_type">expression_candidate</data><data key="display">ただし</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.5.1:C6" target="f:ただし" id="e277"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:3.5.1:C6" target="f:ではない" id="e278"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.5.2:C6"><data key="node_type">sentence</data><data key="display">分類できないものを無理に分類すると、誤認が起こる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L119:C6</data><data key="split">register</data></node><edge source="s:SAT:3.5.2:C6" target="t:分類" id="e279"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:無理"><data key="node_type">term_candidate</data><data key="display">無理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.5.2:C6" target="t:無理" id="e280"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5.2:C6" target="t:誤認" id="e281"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5.2:C6" target="f:できない" id="e282"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.5.3:C6"><data key="node_type">sentence</data><data key="display">分類できないものを存在しないものとして扱うと、履歴切断が起こる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L121:C6</data><data key="split">register</data></node><edge source="s:SAT:3.5.3:C6" target="t:分類" id="e283"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5.3:C6" target="t:存在" id="e284"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:履歴切断"><data key="node_type">term_candidate</data><data key="display">履歴切断</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.5.3:C6" target="t:履歴切断" id="e285"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.5.3:C6" target="f:できない" id="e286"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:3.5.3:C6" target="f:として" id="e287"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.6:C4"><data key="node_type">sentence</data><data key="display">悟性の研究は、分類の成功だけでは足りない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L123:C4</data><data key="split">register</data></node><edge source="s:SAT:3.6:C4" target="t:悟性" id="e288"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.6:C4" target="t:研究" id="e289"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.6:C4" target="t:分類" id="e290"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:成功"><data key="node_type">term_candidate</data><data key="display">成功</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.6:C4" target="t:成功" id="e291"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:3.7:C4"><data key="node_type">sentence</data><data key="display">悟性の研究は、分類不能性がどのような残差を発生させるかを問う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L125:C4</data><data key="split">register</data></node><edge source="s:SAT:3.7:C4" target="t:悟性" id="e292"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.7:C4" target="t:研究" id="e293"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分類不能性"><data key="node_type">term_candidate</data><data key="display">分類不能性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.7:C4" target="t:分類不能性" id="e294"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.7:C4" target="t:残差" id="e295"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:発生"><data key="node_type">term_candidate</data><data key="display">発生</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.7:C4" target="t:発生" id="e296"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.7:C4" target="f:問う" id="e297"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.8:C4"><data key="node_type">sentence</data><data key="display">分類不能性は、失敗である場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L127:C4</data><data key="split">register</data></node><edge source="s:SAT:3.8:C4" target="t:分類不能性" id="e298"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.8:C4" target="t:失敗" id="e299"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:場合"><data key="node_type">term_candidate</data><data key="display">場合</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.8:C4" target="t:場合" id="e300"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.8:C4" target="f:である" id="e301"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:3.9:C4"><data key="node_type">sentence</data><data key="display">分類不能性は、新しい分類形式を要求する場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L129:C4</data><data key="split">register</data></node><edge source="s:SAT:3.9:C4" target="t:分類不能性" id="e302"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分類形式"><data key="node_type">term_candidate</data><data key="display">分類形式</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.9:C4" target="t:分類形式" id="e303"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:要求"><data key="node_type">term_candidate</data><data key="display">要求</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.9:C4" target="t:要求" id="e304"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.9:C4" target="t:場合" id="e305"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:3.10:C5"><data key="node_type">sentence</data><data key="display">悟性の暴走は、分類できるものだけを存在と誤認することである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L131:C5</data><data key="split">register</data></node><edge source="s:SAT:3.10:C5" target="t:悟性" id="e306"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:暴走"><data key="node_type">term_candidate</data><data key="display">暴走</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:3.10:C5" target="t:暴走" id="e307"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.10:C5" target="t:分類" id="e308"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.10:C5" target="t:存在" id="e309"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.10:C5" target="t:誤認" id="e310"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:3.10:C5" target="f:である" id="e311"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.1:C4"><data key="node_type">sentence</data><data key="display">感性と悟性は、単なる心理能力ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L137:C4</data><data key="split">register</data></node><edge source="s:SAT:4.1:C4" target="t:感性" id="e312"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.1:C4" target="t:悟性" id="e313"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:心理能力"><data key="node_type">term_candidate</data><data key="display">心理能力</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.1:C4" target="t:心理能力" id="e314"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.1:C4" target="f:ではない" id="e315"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.2:C4"><data key="node_type">sentence</data><data key="display">感性は、外部入力がどの形式空間において信号として立ち上がるかを問う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L139:C4</data><data key="split">test</data></node><edge source="s:SAT:4.2:C4" target="t:感性" id="e316"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.2:C4" target="t:外部入力" id="e317"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:形式空間"><data key="node_type">term_candidate</data><data key="display">形式空間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.2:C4" target="t:形式空間" id="e318"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.2:C4" target="t:信号" id="e319"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.2:C4" target="f:において" id="e320"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.2:C4" target="f:として" id="e321"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.2:C4" target="f:問う" id="e322"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.3:C4"><data key="node_type">sentence</data><data key="display">悟性は、立ち上がった信号がどの形式空間において対象・関係・因果・量・質・意味として分類されるかを問う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L141:C4</data><data key="split">register</data></node><edge source="s:SAT:4.3:C4" target="t:悟性" id="e323"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="t:信号" id="e324"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="t:形式空間" id="e325"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="t:対象" id="e326"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="t:関係" id="e327"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:因果"><data key="node_type">term_candidate</data><data key="display">因果</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.3:C4" target="t:因果" id="e328"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="t:意味" id="e329"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="t:分類" id="e330"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="f:において" id="e331"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="f:として" id="e332"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.3:C4" target="f:問う" id="e333"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.4:C4"><data key="node_type">sentence</data><data key="display">したがって、感性論と悟性論は、形式空間論を要求する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L143:C4</data><data key="split">register</data></node><node id="t:感性論"><data key="node_type">term_candidate</data><data key="display">感性論</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.4:C4" target="t:感性論" id="e334"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:悟性論"><data key="node_type">term_candidate</data><data key="display">悟性論</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.4:C4" target="t:悟性論" id="e335"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:形式空間論"><data key="node_type">term_candidate</data><data key="display">形式空間論</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.4:C4" target="t:形式空間論" id="e336"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.4:C4" target="t:要求" id="e337"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.4:C4" target="f:したがって" id="e338"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.5:C4"><data key="node_type">sentence</data><data key="display">ここでいう形式空間には、ヒルベルト空間、rigged Hilbert 空間、エントロピー空間、およびそれらに対応する観測・分類・意味生成の空間が含まれる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L145:C4</data><data key="split">test</data></node><edge source="s:SAT:4.5:C4" target="t:形式空間" id="e339"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:ヒルベルト"><data key="node_type">term_candidate</data><data key="display">ヒルベルト</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5:C4" target="t:ヒルベルト" id="e340"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:空間"><data key="node_type">term_candidate</data><data key="display">空間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5:C4" target="t:空間" id="e341"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:rigged"><data key="node_type">term_candidate</data><data key="display">rigged</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5:C4" target="t:rigged" id="e342"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:Hilbert"><data key="node_type">term_candidate</data><data key="display">Hilbert</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5:C4" target="t:Hilbert" id="e343"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:エントロピー"><data key="node_type">term_candidate</data><data key="display">エントロピー</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5:C4" target="t:エントロピー" id="e344"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:対応"><data key="node_type">term_candidate</data><data key="display">対応</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5:C4" target="t:対応" id="e345"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5:C4" target="t:観測" id="e346"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5:C4" target="t:分類" id="e347"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:意味生成"><data key="node_type">term_candidate</data><data key="display">意味生成</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5:C4" target="t:意味生成" id="e348"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:4.5.1:C6"><data key="node_type">sentence</data><data key="display">ヒルベルト空間は、状態・射影・観測断面を考えるための形式空間である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L147:C6</data><data key="split">register</data></node><edge source="s:SAT:4.5.1:C6" target="t:ヒルベルト" id="e349"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.1:C6" target="t:空間" id="e350"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:状態"><data key="node_type">term_candidate</data><data key="display">状態</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.1:C6" target="t:状態" id="e351"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:射影"><data key="node_type">term_candidate</data><data key="display">射影</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.1:C6" target="t:射影" id="e352"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:観測断面"><data key="node_type">term_candidate</data><data key="display">観測断面</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.1:C6" target="t:観測断面" id="e353"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.1:C6" target="t:形式空間" id="e354"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.1:C6" target="f:である" id="e355"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.5.1.1:C8"><data key="node_type">sentence</data><data key="display">境界認識批判におけるヒルベルト空間への関心は、物理状態の再計算ではなく、何が状態化され、何が射影から漏れるかにある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L149:C8</data><data key="split">register</data></node><edge source="s:SAT:4.5.1.1:C8" target="t:境界認識批判" id="e356"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.1.1:C8" target="t:ヒルベルト" id="e357"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.1.1:C8" target="t:空間" id="e358"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:関心"><data key="node_type">term_candidate</data><data key="display">関心</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.1.1:C8" target="t:関心" id="e359"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:物理状態"><data key="node_type">term_candidate</data><data key="display">物理状態</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.1.1:C8" target="t:物理状態" id="e360"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:再計算"><data key="node_type">term_candidate</data><data key="display">再計算</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.1.1:C8" target="t:再計算" id="e361"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:状態化"><data key="node_type">term_candidate</data><data key="display">状態化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.1.1:C8" target="t:状態化" id="e362"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.1.1:C8" target="t:射影" id="e363"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:4.5.2:C6"><data key="node_type">sentence</data><data key="display">rigged Hilbert 空間は、通常の状態空間では閉じにくい一般化状態・境界状態・連続的対象を扱うための拡張空間である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L151:C6</data><data key="split">register</data></node><edge source="s:SAT:4.5.2:C6" target="t:rigged" id="e364"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2:C6" target="t:Hilbert" id="e365"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2:C6" target="t:空間" id="e366"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:通常"><data key="node_type">term_candidate</data><data key="display">通常</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.2:C6" target="t:通常" id="e367"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:状態空間"><data key="node_type">term_candidate</data><data key="display">状態空間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.2:C6" target="t:状態空間" id="e368"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:一般化状態"><data key="node_type">term_candidate</data><data key="display">一般化状態</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.2:C6" target="t:一般化状態" id="e369"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:境界状態"><data key="node_type">term_candidate</data><data key="display">境界状態</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.2:C6" target="t:境界状態" id="e370"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:連続的対象"><data key="node_type">term_candidate</data><data key="display">連続的対象</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.2:C6" target="t:連続的対象" id="e371"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:拡張空間"><data key="node_type">term_candidate</data><data key="display">拡張空間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.2:C6" target="t:拡張空間" id="e372"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2:C6" target="f:である" id="e373"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.5.2.1:C8"><data key="node_type">sentence</data><data key="display">境界認識批判におけるrigged Hilbert 空間への関心は、正規化された状態として閉じにくいもの、または観測断面に安定的に収まりきらないものをどう扱うかにある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L153:C8</data><data key="split">tune</data></node><edge source="s:SAT:4.5.2.1:C8" target="t:境界認識批判" id="e374"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2.1:C8" target="t:rigged" id="e375"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2.1:C8" target="t:Hilbert" id="e376"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2.1:C8" target="t:空間" id="e377"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2.1:C8" target="t:関心" id="e378"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:正規化"><data key="node_type">term_candidate</data><data key="display">正規化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.2.1:C8" target="t:正規化" id="e379"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2.1:C8" target="t:状態" id="e380"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2.1:C8" target="t:観測断面" id="e381"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:安定的"><data key="node_type">term_candidate</data><data key="display">安定的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.2.1:C8" target="t:安定的" id="e382"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.2.1:C8" target="f:として" id="e383"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.5.3:C6"><data key="node_type">sentence</data><data key="display">エントロピー空間は、分布・散逸・圧縮・ノイズ・未統合残差を扱うための空間である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L155:C6</data><data key="split">register</data></node><edge source="s:SAT:4.5.3:C6" target="t:エントロピー" id="e384"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.3:C6" target="t:空間" id="e385"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分布"><data key="node_type">term_candidate</data><data key="display">分布</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.3:C6" target="t:分布" id="e386"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:散逸"><data key="node_type">term_candidate</data><data key="display">散逸</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.3:C6" target="t:散逸" id="e387"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:圧縮"><data key="node_type">term_candidate</data><data key="display">圧縮</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.3:C6" target="t:圧縮" id="e388"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.3:C6" target="t:ノイズ" id="e389"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未統合残差"><data key="node_type">term_candidate</data><data key="display">未統合残差</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.3:C6" target="t:未統合残差" id="e390"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.3:C6" target="f:である" id="e391"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.5.3.1:C8"><data key="node_type">sentence</data><data key="display">境界認識批判におけるエントロピー空間への関心は、ノイズを消すことではなく、ノイズがどの境界不整合を示すかを読むことにある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L157:C8</data><data key="split">register</data></node><edge source="s:SAT:4.5.3.1:C8" target="t:境界認識批判" id="e392"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.3.1:C8" target="t:エントロピー" id="e393"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.3.1:C8" target="t:空間" id="e394"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.3.1:C8" target="t:関心" id="e395"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.5.3.1:C8" target="t:ノイズ" id="e396"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:境界不整合"><data key="node_type">term_candidate</data><data key="display">境界不整合</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.5.3.1:C8" target="t:境界不整合" id="e397"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:4.6:C4"><data key="node_type">sentence</data><data key="display">境界認識批判にとって重要なのは、これらの空間がエネルギーをどう扱うかではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L159:C4</data><data key="split">register</data></node><edge source="s:SAT:4.6:C4" target="t:境界認識批判" id="e398"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:重要"><data key="node_type">term_candidate</data><data key="display">重要</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.6:C4" target="t:重要" id="e399"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.6:C4" target="t:空間" id="e400"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:エネルギー"><data key="node_type">term_candidate</data><data key="display">エネルギー</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.6:C4" target="t:エネルギー" id="e401"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.6:C4" target="f:ではない" id="e402"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.6.1:C6"><data key="node_type">sentence</data><data key="display">それは物理学の仕事である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L161:C6</data><data key="split">test</data></node><node id="t:物理学"><data key="node_type">term_candidate</data><data key="display">物理学</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.6.1:C6" target="t:物理学" id="e403"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:仕事"><data key="node_type">term_candidate</data><data key="display">仕事</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.6.1:C6" target="t:仕事" id="e404"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.6.1:C6" target="f:である" id="e405"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.6.2:C6"><data key="node_type">sentence</data><data key="display">境界認識批判が追うべきなのは、各形式空間が何を状態化し、何を観測可能にし、何を分類不能にし、何をノイズ・残差・意味圧として漏出させるかである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L163:C6</data><data key="split">register</data></node><edge source="s:SAT:4.6.2:C6" target="t:境界認識批判" id="e406"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:各形式空間"><data key="node_type">term_candidate</data><data key="display">各形式空間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.6.2:C6" target="t:各形式空間" id="e407"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.6.2:C6" target="t:状態化" id="e408"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.6.2:C6" target="t:観測可能" id="e409"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分類不能"><data key="node_type">term_candidate</data><data key="display">分類不能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.6.2:C6" target="t:分類不能" id="e410"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.6.2:C6" target="t:ノイズ" id="e411"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.6.2:C6" target="t:残差" id="e412"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:意味圧"><data key="node_type">term_candidate</data><data key="display">意味圧</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.6.2:C6" target="t:意味圧" id="e413"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:漏出"><data key="node_type">term_candidate</data><data key="display">漏出</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.6.2:C6" target="t:漏出" id="e414"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.6.2:C6" target="f:として" id="e415"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.6.2:C6" target="f:である" id="e416"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.7:C4"><data key="node_type">sentence</data><data key="display">したがって、存在境界論は時空だけを扱わない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L165:C4</data><data key="split">register</data></node><node id="t:存在境界論"><data key="node_type">term_candidate</data><data key="display">存在境界論</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7:C4" target="t:存在境界論" id="e417"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:時空"><data key="node_type">term_candidate</data><data key="display">時空</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7:C4" target="t:時空" id="e418"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7:C4" target="f:したがって" id="e419"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.7.1:C6"><data key="node_type">sentence</data><data key="display">存在境界論は、外的時空に加えて、内在時間、エントロピー時間、論理-深度軸を扱う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L167:C6</data><data key="split">test</data></node><edge source="s:SAT:4.7.1:C6" target="t:存在境界論" id="e420"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外的時空"><data key="node_type">term_candidate</data><data key="display">外的時空</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1:C6" target="t:外的時空" id="e421"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:内在時間"><data key="node_type">term_candidate</data><data key="display">内在時間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1:C6" target="t:内在時間" id="e422"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1:C6" target="t:エントロピー" id="e423"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:時間"><data key="node_type">term_candidate</data><data key="display">時間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1:C6" target="t:時間" id="e424"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:論理"><data key="node_type">term_candidate</data><data key="display">論理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1:C6" target="t:論理" id="e425"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:深度軸"><data key="node_type">term_candidate</data><data key="display">深度軸</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1:C6" target="t:深度軸" id="e426"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:4.7.1.1:C8"><data key="node_type">sentence</data><data key="display">外的時空とは、物理的・社会的に共有される時間空間順序である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L169:C8</data><data key="split">register</data></node><edge source="s:SAT:4.7.1.1:C8" target="t:外的時空" id="e427"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:物理的"><data key="node_type">term_candidate</data><data key="display">物理的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.1:C8" target="t:物理的" id="e428"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:社会的"><data key="node_type">term_candidate</data><data key="display">社会的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.1:C8" target="t:社会的" id="e429"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:共有"><data key="node_type">term_candidate</data><data key="display">共有</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.1:C8" target="t:共有" id="e430"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:時間空間順序"><data key="node_type">term_candidate</data><data key="display">時間空間順序</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.1:C8" target="t:時間空間順序" id="e431"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.1:C8" target="f:とは" id="e432"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.1:C8" target="f:である" id="e433"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.7.1.2:C8"><data key="node_type">sentence</data><data key="display">内在時間とは、履歴場内部において、意味・反応・残差が更新される順序である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L171:C8</data><data key="split">test</data></node><edge source="s:SAT:4.7.1.2:C8" target="t:内在時間" id="e434"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:履歴場内部"><data key="node_type">term_candidate</data><data key="display">履歴場内部</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.2:C8" target="t:履歴場内部" id="e435"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.2:C8" target="t:意味" id="e436"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.2:C8" target="t:反応" id="e437"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.2:C8" target="t:残差" id="e438"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.2:C8" target="t:更新" id="e439"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:順序"><data key="node_type">term_candidate</data><data key="display">順序</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.2:C8" target="t:順序" id="e440"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.2:C8" target="f:とは" id="e441"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.2:C8" target="f:において" id="e442"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.2:C8" target="f:である" id="e443"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.7.1.3:C8"><data key="node_type">sentence</data><data key="display">エントロピー時間とは、差異・ノイズ・未統合残差が、閉鎖・保留・再符号化・切断へ向かう処理方向である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L173:C8</data><data key="split">register</data></node><edge source="s:SAT:4.7.1.3:C8" target="t:エントロピー" id="e444"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.3:C8" target="t:時間" id="e445"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:差異"><data key="node_type">term_candidate</data><data key="display">差異</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.3:C8" target="t:差異" id="e446"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.3:C8" target="t:ノイズ" id="e447"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.3:C8" target="t:未統合残差" id="e448"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:閉鎖"><data key="node_type">term_candidate</data><data key="display">閉鎖</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.3:C8" target="t:閉鎖" id="e449"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.3:C8" target="t:保留" id="e450"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.3:C8" target="t:再符号化" id="e451"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:切断"><data key="node_type">term_candidate</data><data key="display">切断</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.3:C8" target="t:切断" id="e452"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:処理方向"><data key="node_type">term_candidate</data><data key="display">処理方向</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.3:C8" target="t:処理方向" id="e453"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.3:C8" target="f:とは" id="e454"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.3:C8" target="f:である" id="e455"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.7.1.4:C8"><data key="node_type">sentence</data><data key="display">論理-深度軸とは、外的時間の前後ではなく、未解決・矛盾・分岐・残差・意味圧をどれだけ保持し、再構成できるかを示す深度方向である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L175:C8</data><data key="split">tune</data></node><edge source="s:SAT:4.7.1.4:C8" target="t:論理" id="e456"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.4:C8" target="t:深度軸" id="e457"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外的時間"><data key="node_type">term_candidate</data><data key="display">外的時間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.4:C8" target="t:外的時間" id="e458"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:前後"><data key="node_type">term_candidate</data><data key="display">前後</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.4:C8" target="t:前後" id="e459"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未解決"><data key="node_type">term_candidate</data><data key="display">未解決</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.4:C8" target="t:未解決" id="e460"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:矛盾"><data key="node_type">term_candidate</data><data key="display">矛盾</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.4:C8" target="t:矛盾" id="e461"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分岐"><data key="node_type">term_candidate</data><data key="display">分岐</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.4:C8" target="t:分岐" id="e462"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.4:C8" target="t:残差" id="e463"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.4:C8" target="t:意味圧" id="e464"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.4:C8" target="t:保持" id="e465"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.4:C8" target="t:再構成" id="e466"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:深度方向"><data key="node_type">term_candidate</data><data key="display">深度方向</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.7.1.4:C8" target="t:深度方向" id="e467"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.4:C8" target="f:とは" id="e468"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.7.1.4:C8" target="f:である" id="e469"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.8:C4"><data key="node_type">sentence</data><data key="display">存在境界論の主たる探究対象は、この形式空間と時間軸の交差において、認識・意味・観測・ノイズ・残差がどのように立ち上がるかである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L177:C4</data><data key="split">register</data></node><edge source="s:SAT:4.8:C4" target="t:存在境界論" id="e470"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:探究対象"><data key="node_type">term_candidate</data><data key="display">探究対象</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.8:C4" target="t:探究対象" id="e471"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.8:C4" target="t:形式空間" id="e472"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:時間軸"><data key="node_type">term_candidate</data><data key="display">時間軸</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.8:C4" target="t:時間軸" id="e473"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:交差"><data key="node_type">term_candidate</data><data key="display">交差</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.8:C4" target="t:交差" id="e474"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.8:C4" target="t:認識" id="e475"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.8:C4" target="t:意味" id="e476"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.8:C4" target="t:観測" id="e477"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.8:C4" target="t:ノイズ" id="e478"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.8:C4" target="t:残差" id="e479"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.8:C4" target="f:において" id="e480"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:4.8:C4" target="f:である" id="e481"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:4.9:C4"><data key="node_type">sentence</data><data key="display">この章は、境界認識批判から分岐する詳細研究領域であり、空間論・時間論・境界ノイズ論として別稿化される。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L179:C4</data><data key="split">register</data></node><edge source="s:SAT:4.9:C4" target="t:境界認識批判" id="e482"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.9:C4" target="t:分岐" id="e483"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:詳細研究領域"><data key="node_type">term_candidate</data><data key="display">詳細研究領域</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.9:C4" target="t:詳細研究領域" id="e484"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:空間論"><data key="node_type">term_candidate</data><data key="display">空間論</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.9:C4" target="t:空間論" id="e485"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:時間論"><data key="node_type">term_candidate</data><data key="display">時間論</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.9:C4" target="t:時間論" id="e486"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.9:C4" target="t:境界" id="e487"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.9:C4" target="t:ノイズ" id="e488"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:別稿化"><data key="node_type">term_candidate</data><data key="display">別稿化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:4.9:C4" target="t:別稿化" id="e489"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:4.9:C4" target="f:として" id="e490"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.1:C4"><data key="node_type">sentence</data><data key="display">理性とは、未閉鎖の入力・分類・判断を、より大きな内部ループへ統合しようとする力である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L185:C4</data><data key="split">register</data></node><node id="t:理性"><data key="node_type">term_candidate</data><data key="display">理性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.1:C4" target="t:理性" id="e491"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未閉鎖"><data key="node_type">term_candidate</data><data key="display">未閉鎖</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.1:C4" target="t:未閉鎖" id="e492"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.1:C4" target="t:入力" id="e493"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.1:C4" target="t:分類" id="e494"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.1:C4" target="t:判断" id="e495"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.1:C4" target="t:内部" id="e496"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:ループ"><data key="node_type">term_candidate</data><data key="display">ループ</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.1:C4" target="t:ループ" id="e497"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:統合"><data key="node_type">term_candidate</data><data key="display">統合</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.1:C4" target="t:統合" id="e498"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.1:C4" target="f:とは" id="e499"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.1:C4" target="f:とする" id="e500"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.1:C4" target="f:である" id="e501"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.2:C4"><data key="node_type">sentence</data><data key="display">理性は、一貫した説明を求める。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L187:C4</data><data key="split">register</data></node><edge source="s:SAT:5.2:C4" target="t:理性" id="e502"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:一貫"><data key="node_type">term_candidate</data><data key="display">一貫</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.2:C4" target="t:一貫" id="e503"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:説明"><data key="node_type">term_candidate</data><data key="display">説明</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.2:C4" target="t:説明" id="e504"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:5.3:C4"><data key="node_type">sentence</data><data key="display">理性は、根拠を求める。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L189:C4</data><data key="split">register</data></node><edge source="s:SAT:5.3:C4" target="t:理性" id="e505"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:根拠"><data key="node_type">term_candidate</data><data key="display">根拠</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.3:C4" target="t:根拠" id="e506"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:5.4:C4"><data key="node_type">sentence</data><data key="display">理性は、世界像を求める。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L191:C4</data><data key="split">test</data></node><edge source="s:SAT:5.4:C4" target="t:理性" id="e507"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:世界像"><data key="node_type">term_candidate</data><data key="display">世界像</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.4:C4" target="t:世界像" id="e508"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:5.5:C4"><data key="node_type">sentence</data><data key="display">理性は、未解決を閉じたがる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L193:C4</data><data key="split">register</data></node><edge source="s:SAT:5.5:C4" target="t:理性" id="e509"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.5:C4" target="t:未解決" id="e510"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:5.6:C4"><data key="node_type">sentence</data><data key="display">したがって、理性は有用である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L195:C4</data><data key="split">register</data></node><edge source="s:SAT:5.6:C4" target="t:理性" id="e511"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:有用"><data key="node_type">term_candidate</data><data key="display">有用</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.6:C4" target="t:有用" id="e512"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.6:C4" target="f:したがって" id="e513"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.6:C4" target="f:である" id="e514"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.7:C4"><data key="node_type">sentence</data><data key="display">しかし、理性は危険でもある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L197:C4</data><data key="split">register</data></node><edge source="s:SAT:5.7:C4" target="t:理性" id="e515"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:危険"><data key="node_type">term_candidate</data><data key="display">危険</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.7:C4" target="t:危険" id="e516"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.7:C4" target="f:しかし" id="e517"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.8:C4"><data key="node_type">sentence</data><data key="display">理性が外部同期可能な範囲を越えて内部ループを閉じようとすると、偽閉鎖が起こる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L199:C4</data><data key="split">register</data></node><edge source="s:SAT:5.8:C4" target="t:理性" id="e518"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外部同期可能"><data key="node_type">term_candidate</data><data key="display">外部同期可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.8:C4" target="t:外部同期可能" id="e519"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:範囲"><data key="node_type">term_candidate</data><data key="display">範囲</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.8:C4" target="t:範囲" id="e520"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8:C4" target="t:内部" id="e521"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8:C4" target="t:ループ" id="e522"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:偽閉鎖"><data key="node_type">term_candidate</data><data key="display">偽閉鎖</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.8:C4" target="t:偽閉鎖" id="e523"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8:C4" target="f:とする" id="e524"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.8.1:C6"><data key="node_type">sentence</data><data key="display">偽閉鎖とは、未解決であるものを、解決済みのように扱うことである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L201:C6</data><data key="split">test</data></node><edge source="s:SAT:5.8.1:C6" target="t:偽閉鎖" id="e525"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.1:C6" target="t:未解決" id="e526"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:解決済"><data key="node_type">term_candidate</data><data key="display">解決済</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.8.1:C6" target="t:解決済" id="e527"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.1:C6" target="f:とは" id="e528"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.8.1:C6" target="f:である" id="e529"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.8.2:C6"><data key="node_type">sentence</data><data key="display">理性の暴走とは、内部ループの閉鎖欲が、外部同期と照合を失った状態である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L203:C6</data><data key="split">register</data></node><edge source="s:SAT:5.8.2:C6" target="t:理性" id="e530"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.2:C6" target="t:暴走" id="e531"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.2:C6" target="t:内部" id="e532"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.2:C6" target="t:ループ" id="e533"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:閉鎖欲"><data key="node_type">term_candidate</data><data key="display">閉鎖欲</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.8.2:C6" target="t:閉鎖欲" id="e534"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.2:C6" target="t:外部同期" id="e535"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.2:C6" target="t:照合" id="e536"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.2:C6" target="t:状態" id="e537"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.8.2:C6" target="f:とは" id="e538"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.8.2:C6" target="f:である" id="e539"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.9:C4"><data key="node_type">sentence</data><data key="display">批判とは、理性を否定することではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L205:C4</data><data key="split">register</data></node><node id="t:批判"><data key="node_type">term_candidate</data><data key="display">批判</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.9:C4" target="t:批判" id="e540"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.9:C4" target="t:理性" id="e541"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:否定"><data key="node_type">term_candidate</data><data key="display">否定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.9:C4" target="t:否定" id="e542"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.9:C4" target="f:とは" id="e543"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.9:C4" target="f:ではない" id="e544"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.10:C5"><data key="node_type">sentence</data><data key="display">批判とは、理性が正当に閉じられる範囲と、閉じてはならない範囲を区別することである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L207:C5</data><data key="split">register</data></node><edge source="s:SAT:5.10:C5" target="t:批判" id="e545"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.10:C5" target="t:理性" id="e546"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:正当"><data key="node_type">term_candidate</data><data key="display">正当</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.10:C5" target="t:正当" id="e547"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.10:C5" target="t:範囲" id="e548"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.10:C5" target="t:区別" id="e549"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.10:C5" target="f:とは" id="e550"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.10:C5" target="f:である" id="e551"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.11:C5"><data key="node_type">sentence</data><data key="display">理性の成熟とは、閉じる力を持ちながら、閉じてはならない残差を保持できることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L209:C5</data><data key="split">tune</data></node><edge source="s:SAT:5.11:C5" target="t:理性" id="e552"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:成熟"><data key="node_type">term_candidate</data><data key="display">成熟</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.11:C5" target="t:成熟" id="e553"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.11:C5" target="t:残差" id="e554"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.11:C5" target="t:保持" id="e555"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.11:C5" target="f:とは" id="e556"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.11:C5" target="f:である" id="e557"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:5.12:C5"><data key="node_type">sentence</data><data key="display">理性の未成熟とは、未閉鎖を嫌い、残差を偽閉鎖することである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L211:C5</data><data key="split">tune</data></node><edge source="s:SAT:5.12:C5" target="t:理性" id="e558"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未成熟"><data key="node_type">term_candidate</data><data key="display">未成熟</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:5.12:C5" target="t:未成熟" id="e559"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.12:C5" target="t:未閉鎖" id="e560"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.12:C5" target="t:残差" id="e561"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.12:C5" target="t:偽閉鎖" id="e562"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:5.12:C5" target="f:とは" id="e563"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:5.12:C5" target="f:である" id="e564"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.1:C4"><data key="node_type">sentence</data><data key="display">法則とは、外部から与えられた絶対命令ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L217:C4</data><data key="split">register</data></node><node id="t:法則"><data key="node_type">term_candidate</data><data key="display">法則</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.1:C4" target="t:法則" id="e565"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.1:C4" target="t:外部" id="e566"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:絶対命令"><data key="node_type">term_candidate</data><data key="display">絶対命令</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.1:C4" target="t:絶対命令" id="e567"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.1:C4" target="f:とは" id="e568"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:6.1:C4" target="f:ではない" id="e569"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.2:C4"><data key="node_type">sentence</data><data key="display">法則とは、単なる主観的な思い込みでもない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L219:C4</data><data key="split">test</data></node><edge source="s:SAT:6.2:C4" target="t:法則" id="e570"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:主観的"><data key="node_type">term_candidate</data><data key="display">主観的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.2:C4" target="t:主観的" id="e571"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.2:C4" target="f:とは" id="e572"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.3:C4"><data key="node_type">sentence</data><data key="display">法則とは、外部経験との同期可能性を持つ、高安定のヒューリスティック体系である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L221:C4</data><data key="split">register</data></node><edge source="s:SAT:6.3:C4" target="t:法則" id="e573"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外部経験"><data key="node_type">term_candidate</data><data key="display">外部経験</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.3:C4" target="t:外部経験" id="e574"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:同期可能性"><data key="node_type">term_candidate</data><data key="display">同期可能性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.3:C4" target="t:同期可能性" id="e575"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:高安定"><data key="node_type">term_candidate</data><data key="display">高安定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.3:C4" target="t:高安定" id="e576"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.3:C4" target="t:ヒューリスティック" id="e577"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:体系"><data key="node_type">term_candidate</data><data key="display">体系</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.3:C4" target="t:体系" id="e578"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.3:C4" target="f:とは" id="e579"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:6.3:C4" target="f:である" id="e580"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.4:C4"><data key="node_type">sentence</data><data key="display">ヒューリスティックとは、経験を圧縮し、次の判断に使える形へ閉じた理解である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L223:C4</data><data key="split">register</data></node><edge source="s:SAT:6.4:C4" target="t:ヒューリスティック" id="e581"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4:C4" target="t:経験" id="e582"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4:C4" target="t:圧縮" id="e583"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4:C4" target="t:判断" id="e584"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:理解"><data key="node_type">term_candidate</data><data key="display">理解</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4:C4" target="t:理解" id="e585"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4:C4" target="f:とは" id="e586"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:6.4:C4" target="f:である" id="e587"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.4.1:C6"><data key="node_type">sentence</data><data key="display">私的ヒューリスティックは、個人の経験に閉じる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L225:C6</data><data key="split">test</data></node><node id="t:私的"><data key="node_type">term_candidate</data><data key="display">私的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.1:C6" target="t:私的" id="e588"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.1:C6" target="t:ヒューリスティック" id="e589"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:個人"><data key="node_type">term_candidate</data><data key="display">個人</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.1:C6" target="t:個人" id="e590"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.1:C6" target="t:経験" id="e591"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:6.4.2:C6"><data key="node_type">sentence</data><data key="display">共同体的ヒューリスティックは、共同体内で安定する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L227:C6</data><data key="split">register</data></node><node id="t:共同体的"><data key="node_type">term_candidate</data><data key="display">共同体的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.2:C6" target="t:共同体的" id="e592"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.2:C6" target="t:ヒューリスティック" id="e593"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:共同体内"><data key="node_type">term_candidate</data><data key="display">共同体内</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.2:C6" target="t:共同体内" id="e594"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:安定"><data key="node_type">term_candidate</data><data key="display">安定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.2:C6" target="t:安定" id="e595"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:6.4.3:C6"><data key="node_type">sentence</data><data key="display">科学的ヒューリスティックは、観測・測定・再現・反証・更新を通じて、外部との同期可能性を高める。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L229:C6</data><data key="split">test</data></node><node id="t:科学的"><data key="node_type">term_candidate</data><data key="display">科学的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3:C6" target="t:科学的" id="e596"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3:C6" target="t:ヒューリスティック" id="e597"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3:C6" target="t:観測" id="e598"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:測定"><data key="node_type">term_candidate</data><data key="display">測定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3:C6" target="t:測定" id="e599"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:再現"><data key="node_type">term_candidate</data><data key="display">再現</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3:C6" target="t:再現" id="e600"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:反証"><data key="node_type">term_candidate</data><data key="display">反証</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3:C6" target="t:反証" id="e601"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3:C6" target="t:更新" id="e602"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3:C6" target="t:外部" id="e603"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3:C6" target="t:同期可能性" id="e604"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:を通じて"><data key="node_type">expression_candidate</data><data key="display">を通じて</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3:C6" target="f:を通じて" id="e605"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.4.3.1:C8"><data key="node_type">sentence</data><data key="display">物理法則は、その中でも、外的時空内で極めて高い同期精度を持つ法則体系である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L231:C8</data><data key="split">register</data></node><node id="t:物理法則"><data key="node_type">term_candidate</data><data key="display">物理法則</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3.1:C8" target="t:物理法則" id="e606"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外的時空内"><data key="node_type">term_candidate</data><data key="display">外的時空内</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3.1:C8" target="t:外的時空内" id="e607"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:同期精度"><data key="node_type">term_candidate</data><data key="display">同期精度</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3.1:C8" target="t:同期精度" id="e608"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:法則体系"><data key="node_type">term_candidate</data><data key="display">法則体系</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3.1:C8" target="t:法則体系" id="e609"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3.1:C8" target="f:である" id="e610"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.4.3.2:C8"><data key="node_type">sentence</data><data key="display">したがって、科学を否定する必要はない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L233:C8</data><data key="split">tune</data></node><node id="t:科学"><data key="node_type">term_candidate</data><data key="display">科学</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3.2:C8" target="t:科学" id="e611"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3.2:C8" target="t:否定" id="e612"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:必要"><data key="node_type">term_candidate</data><data key="display">必要</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.4.3.2:C8" target="t:必要" id="e613"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3.2:C8" target="f:したがって" id="e614"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.4.3.3:C8"><data key="node_type">sentence</data><data key="display">しかし、科学を神にする必要もない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L235:C8</data><data key="split">test</data></node><edge source="s:SAT:6.4.3.3:C8" target="t:科学" id="e615"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3.3:C8" target="t:必要" id="e616"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.4.3.3:C8" target="f:しかし" id="e617"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.5:C4"><data key="node_type">sentence</data><data key="display">法則は、適用範囲を持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L237:C4</data><data key="split">test</data></node><edge source="s:SAT:6.5:C4" target="t:法則" id="e618"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.5:C4" target="t:適用範囲" id="e619"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:6.5.1:C6"><data key="node_type">sentence</data><data key="display">適用範囲を失った法則は、教義になる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L239:C6</data><data key="split">register</data></node><edge source="s:SAT:6.5.1:C6" target="t:適用範囲" id="e620"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.5.1:C6" target="t:法則" id="e621"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:教義"><data key="node_type">term_candidate</data><data key="display">教義</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.5.1:C6" target="t:教義" id="e622"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:6.5.2:C6"><data key="node_type">sentence</data><data key="display">法則体系の批判とは、法則の成立条件・同期条件・適用範囲・更新条件を問うことである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L241:C6</data><data key="split">test</data></node><edge source="s:SAT:6.5.2:C6" target="t:法則体系" id="e623"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.5.2:C6" target="t:批判" id="e624"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.5.2:C6" target="t:法則" id="e625"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.5.2:C6" target="t:成立条件" id="e626"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:同期条件"><data key="node_type">term_candidate</data><data key="display">同期条件</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.5.2:C6" target="t:同期条件" id="e627"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.5.2:C6" target="t:適用範囲" id="e628"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:更新条件"><data key="node_type">term_candidate</data><data key="display">更新条件</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.5.2:C6" target="t:更新条件" id="e629"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.5.2:C6" target="f:とは" id="e630"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:6.5.2:C6" target="f:問う" id="e631"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:6.5.2:C6" target="f:である" id="e632"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:6.6:C4"><data key="node_type">sentence</data><data key="display">境界認識批判は、法則を弱めない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L243:C4</data><data key="split">register</data></node><edge source="s:SAT:6.6:C4" target="t:境界認識批判" id="e633"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.6:C4" target="t:法則" id="e634"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:6.7:C4"><data key="node_type">sentence</data><data key="display">境界認識批判は、法則が正当に働く範囲と、法則が残差を不可視化する範囲を区別する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L245:C4</data><data key="split">register</data></node><edge source="s:SAT:6.7:C4" target="t:境界認識批判" id="e635"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.7:C4" target="t:法則" id="e636"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.7:C4" target="t:正当" id="e637"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.7:C4" target="t:範囲" id="e638"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.7:C4" target="t:残差" id="e639"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:不可視化"><data key="node_type">term_candidate</data><data key="display">不可視化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:6.7:C4" target="t:不可視化" id="e640"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:6.7:C4" target="t:区別" id="e641"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:7.1:C4"><data key="node_type">sentence</data><data key="display">内部ヒューリスティックとは、履歴場が外部を受け取り、分類し、判断するための内部構造である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L251:C4</data><data key="split">tune</data></node><edge source="s:SAT:7.1:C4" target="t:内部" id="e642"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.1:C4" target="t:ヒューリスティック" id="e643"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.1:C4" target="t:履歴場" id="e644"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.1:C4" target="t:外部" id="e645"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.1:C4" target="t:分類" id="e646"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.1:C4" target="t:判断" id="e647"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:内部構造"><data key="node_type">term_candidate</data><data key="display">内部構造</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.1:C4" target="t:内部構造" id="e648"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.1:C4" target="f:とは" id="e649"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:7.1:C4" target="f:である" id="e650"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:7.2:C4"><data key="node_type">sentence</data><data key="display">外部ヒューリスティックとは、観測、実験、言語、数式、制度、文献、AI、共同体検証などとして外部化された判断構造である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L253:C4</data><data key="split">register</data></node><edge source="s:SAT:7.2:C4" target="t:外部" id="e651"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.2:C4" target="t:ヒューリスティック" id="e652"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.2:C4" target="t:観測" id="e653"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:実験"><data key="node_type">term_candidate</data><data key="display">実験</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:実験" id="e654"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:言語"><data key="node_type">term_candidate</data><data key="display">言語</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:言語" id="e655"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:数式"><data key="node_type">term_candidate</data><data key="display">数式</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:数式" id="e656"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:制度"><data key="node_type">term_candidate</data><data key="display">制度</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:制度" id="e657"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:文献"><data key="node_type">term_candidate</data><data key="display">文献</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:文献" id="e658"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:AI"><data key="node_type">term_candidate</data><data key="display">AI</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:AI" id="e659"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:共同体検証"><data key="node_type">term_candidate</data><data key="display">共同体検証</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:共同体検証" id="e660"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外部化"><data key="node_type">term_candidate</data><data key="display">外部化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:外部化" id="e661"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:判断構造"><data key="node_type">term_candidate</data><data key="display">判断構造</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.2:C4" target="t:判断構造" id="e662"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.2:C4" target="f:とは" id="e663"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:7.2:C4" target="f:として" id="e664"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:7.2:C4" target="f:である" id="e665"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:7.3:C4"><data key="node_type">sentence</data><data key="display">同期とは、内部ヒューリスティックと外部ヒューリスティックが、運用上安定して対応することである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L255:C4</data><data key="split">register</data></node><edge source="s:SAT:7.3:C4" target="t:同期" id="e666"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3:C4" target="t:内部" id="e667"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3:C4" target="t:ヒューリスティック" id="e668"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3:C4" target="t:外部" id="e669"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:運用上安定"><data key="node_type">term_candidate</data><data key="display">運用上安定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.3:C4" target="t:運用上安定" id="e670"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3:C4" target="t:対応" id="e671"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3:C4" target="f:とは" id="e672"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:7.3:C4" target="f:である" id="e673"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:7.3.1:C6"><data key="node_type">sentence</data><data key="display">同期は、機能の条件である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L257:C6</data><data key="split">tune</data></node><edge source="s:SAT:7.3.1:C6" target="t:同期" id="e674"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:機能"><data key="node_type">term_candidate</data><data key="display">機能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.3.1:C6" target="t:機能" id="e675"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:条件"><data key="node_type">term_candidate</data><data key="display">条件</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.3.1:C6" target="t:条件" id="e676"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.1:C6" target="f:である" id="e677"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:7.3.2:C6"><data key="node_type">sentence</data><data key="display">同期しているものは、使える。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L259:C6</data><data key="split">register</data></node><edge source="s:SAT:7.3.2:C6" target="t:同期" id="e678"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:7.3.3:C6"><data key="node_type">sentence</data><data key="display">同期しているものは、予測できる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L261:C6</data><data key="split">register</data></node><edge source="s:SAT:7.3.3:C6" target="t:同期" id="e679"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:予測"><data key="node_type">term_candidate</data><data key="display">予測</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.3.3:C6" target="t:予測" id="e680"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:7.3.4:C6"><data key="node_type">sentence</data><data key="display">同期しているものは、他者と共有しやすい。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L263:C6</data><data key="split">tune</data></node><edge source="s:SAT:7.3.4:C6" target="t:同期" id="e681"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:他者"><data key="node_type">term_candidate</data><data key="display">他者</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.3.4:C6" target="t:他者" id="e682"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.4:C6" target="t:共有" id="e683"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:7.3.5:C6"><data key="node_type">sentence</data><data key="display">しかし、同期だけでは知は完結しない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L265:C6</data><data key="split">register</data></node><edge source="s:SAT:7.3.5:C6" target="t:同期" id="e684"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.5:C6" target="t:知" id="e685"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:完結"><data key="node_type">term_candidate</data><data key="display">完結</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.3.5:C6" target="t:完結" id="e686"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.5:C6" target="f:しかし" id="e687"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:7.3.6:C6"><data key="node_type">sentence</data><data key="display">同期は、一致の意味を説明しない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L267:C6</data><data key="split">register</data></node><edge source="s:SAT:7.3.6:C6" target="t:同期" id="e688"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.6:C6" target="t:一致" id="e689"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.6:C6" target="t:意味" id="e690"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.6:C6" target="t:説明" id="e691"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:7.3.7:C6"><data key="node_type">sentence</data><data key="display">同期は、不一致の意味を説明しない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L269:C6</data><data key="split">register</data></node><edge source="s:SAT:7.3.7:C6" target="t:同期" id="e692"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.7:C6" target="t:不一致" id="e693"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.7:C6" target="t:意味" id="e694"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.7:C6" target="t:説明" id="e695"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:7.3.8:C6"><data key="node_type">sentence</data><data key="display">同期は、残差が何を示しているかを説明しない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L271:C6</data><data key="split">register</data></node><edge source="s:SAT:7.3.8:C6" target="t:同期" id="e696"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.8:C6" target="t:残差" id="e697"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.3.8:C6" target="t:説明" id="e698"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:7.4:C4"><data key="node_type">sentence</data><data key="display">したがって、同期には照合が必要である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L273:C4</data><data key="split">register</data></node><edge source="s:SAT:7.4:C4" target="t:同期" id="e699"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.4:C4" target="t:照合" id="e700"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.4:C4" target="t:必要" id="e701"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.4:C4" target="f:したがって" id="e702"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:必要である"><data key="node_type">expression_candidate</data><data key="display">必要である</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.4:C4" target="f:必要である" id="e703"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:7.5:C4"><data key="node_type">sentence</data><data key="display">同期だけを重視すると、機能するものだけが真であるかのように見える。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L275:C4</data><data key="split">register</data></node><edge source="s:SAT:7.5:C4" target="t:同期" id="e704"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:重視"><data key="node_type">term_candidate</data><data key="display">重視</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.5:C4" target="t:重視" id="e705"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.5:C4" target="t:機能" id="e706"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.5:C4" target="f:である" id="e707"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:7.6:C4"><data key="node_type">sentence</data><data key="display">同期だけを重視すると、機能していないもの、まだ機能形式に乗っていないもの、機能の外部へ押し出されたものが残差として捨てられる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L277:C4</data><data key="split">register</data></node><edge source="s:SAT:7.6:C4" target="t:同期" id="e708"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.6:C4" target="t:重視" id="e709"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.6:C4" target="t:機能" id="e710"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:機能形式"><data key="node_type">term_candidate</data><data key="display">機能形式</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:7.6:C4" target="t:機能形式" id="e711"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.6:C4" target="t:外部" id="e712"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.6:C4" target="t:残差" id="e713"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:7.6:C4" target="f:として" id="e714"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.1:C4"><data key="node_type">sentence</data><data key="display">照合とは、同期の成否だけでなく、一致・不一致・残差が何を意味するかを読む操作である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L283:C4</data><data key="split">register</data></node><edge source="s:SAT:8.1:C4" target="t:照合" id="e715"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.1:C4" target="t:同期" id="e716"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:成否"><data key="node_type">term_candidate</data><data key="display">成否</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.1:C4" target="t:成否" id="e717"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.1:C4" target="t:一致" id="e718"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.1:C4" target="t:不一致" id="e719"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.1:C4" target="t:残差" id="e720"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.1:C4" target="t:意味" id="e721"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:操作"><data key="node_type">term_candidate</data><data key="display">操作</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.1:C4" target="t:操作" id="e722"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.1:C4" target="f:とは" id="e723"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:だけでなく"><data key="node_type">expression_candidate</data><data key="display">だけでなく</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.1:C4" target="f:だけでなく" id="e724"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:8.1:C4" target="f:である" id="e725"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.2:C4"><data key="node_type">sentence</data><data key="display">照合は、単なる比較ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L285:C4</data><data key="split">test</data></node><edge source="s:SAT:8.2:C4" target="t:照合" id="e726"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:比較"><data key="node_type">term_candidate</data><data key="display">比較</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.2:C4" target="t:比較" id="e727"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.2:C4" target="f:ではない" id="e728"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.3:C4"><data key="node_type">sentence</data><data key="display">照合は、どの履歴場において、どの外部ヒューリスティックと、どの条件で一致しているのかを問う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L287:C4</data><data key="split">register</data></node><edge source="s:SAT:8.3:C4" target="t:照合" id="e729"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.3:C4" target="t:履歴場" id="e730"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.3:C4" target="t:外部" id="e731"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.3:C4" target="t:ヒューリスティック" id="e732"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.3:C4" target="t:条件" id="e733"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.3:C4" target="t:一致" id="e734"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.3:C4" target="f:において" id="e735"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:8.3:C4" target="f:問う" id="e736"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.4:C4"><data key="node_type">sentence</data><data key="display">照合は、不一致を単純な誤りとして即時に捨てない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L289:C4</data><data key="split">register</data></node><edge source="s:SAT:8.4:C4" target="t:照合" id="e737"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4:C4" target="t:不一致" id="e738"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:単純"><data key="node_type">term_candidate</data><data key="display">単純</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.4:C4" target="t:単純" id="e739"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:即時"><data key="node_type">term_candidate</data><data key="display">即時</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.4:C4" target="t:即時" id="e740"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4:C4" target="f:として" id="e741"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.4.1:C6"><data key="node_type">sentence</data><data key="display">不一致は、誤りである場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L291:C6</data><data key="split">register</data></node><edge source="s:SAT:8.4.1:C6" target="t:不一致" id="e742"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.1:C6" target="t:場合" id="e743"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.1:C6" target="f:である" id="e744"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.4.2:C6"><data key="node_type">sentence</data><data key="display">不一致は、適用範囲の外を示す場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L293:C6</data><data key="split">register</data></node><edge source="s:SAT:8.4.2:C6" target="t:不一致" id="e745"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.2:C6" target="t:適用範囲" id="e746"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.2:C6" target="t:場合" id="e747"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:8.4.3:C6"><data key="node_type">sentence</data><data key="display">不一致は、新しい分類を要求する場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L295:C6</data><data key="split">register</data></node><edge source="s:SAT:8.4.3:C6" target="t:不一致" id="e748"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.3:C6" target="t:分類" id="e749"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.3:C6" target="t:要求" id="e750"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.3:C6" target="t:場合" id="e751"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:8.4.4:C6"><data key="node_type">sentence</data><data key="display">不一致は、内部ヒューリスティックの更新を要求する場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L297:C6</data><data key="split">tune</data></node><edge source="s:SAT:8.4.4:C6" target="t:不一致" id="e752"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.4:C6" target="t:内部" id="e753"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.4:C6" target="t:ヒューリスティック" id="e754"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.4:C6" target="t:更新" id="e755"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.4:C6" target="t:要求" id="e756"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.4:C6" target="t:場合" id="e757"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:8.4.5:C6"><data key="node_type">sentence</data><data key="display">不一致は、外部ヒューリスティックの限界を示す場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L299:C6</data><data key="split">test</data></node><edge source="s:SAT:8.4.5:C6" target="t:不一致" id="e758"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.5:C6" target="t:外部" id="e759"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.5:C6" target="t:ヒューリスティック" id="e760"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:限界"><data key="node_type">term_candidate</data><data key="display">限界</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.4.5:C6" target="t:限界" id="e761"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.4.5:C6" target="t:場合" id="e762"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:8.5:C4"><data key="node_type">sentence</data><data key="display">残差は、失敗ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L301:C4</data><data key="split">register</data></node><edge source="s:SAT:8.5:C4" target="t:残差" id="e763"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.5:C4" target="t:失敗" id="e764"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.5:C4" target="f:ではない" id="e765"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.5.1:C6"><data key="node_type">sentence</data><data key="display">残差は、未処理の意味である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L303:C6</data><data key="split">register</data></node><edge source="s:SAT:8.5.1:C6" target="t:残差" id="e766"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未処理"><data key="node_type">term_candidate</data><data key="display">未処理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.5.1:C6" target="t:未処理" id="e767"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.5.1:C6" target="t:意味" id="e768"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.5.1:C6" target="f:である" id="e769"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.5.2:C6"><data key="node_type">sentence</data><data key="display">残差は、次の問いの発生源である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L305:C6</data><data key="split">tune</data></node><edge source="s:SAT:8.5.2:C6" target="t:残差" id="e770"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:発生源"><data key="node_type">term_candidate</data><data key="display">発生源</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.5.2:C6" target="t:発生源" id="e771"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.5.2:C6" target="f:である" id="e772"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.6:C4"><data key="node_type">sentence</data><data key="display">照合は、残差を意味の資源として保持する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L307:C4</data><data key="split">register</data></node><edge source="s:SAT:8.6:C4" target="t:照合" id="e773"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.6:C4" target="t:残差" id="e774"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.6:C4" target="t:意味" id="e775"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:資源"><data key="node_type">term_candidate</data><data key="display">資源</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.6:C4" target="t:資源" id="e776"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.6:C4" target="t:保持" id="e777"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.6:C4" target="f:として" id="e778"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:保持する"><data key="node_type">expression_candidate</data><data key="display">保持する</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.6:C4" target="f:保持する" id="e779"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.7:C4"><data key="node_type">sentence</data><data key="display">照合だけを絶対化すると、すべての残差を何らかの意味として閉じようとする。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L309:C4</data><data key="split">register</data></node><edge source="s:SAT:8.7:C4" target="t:照合" id="e780"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:絶対化"><data key="node_type">term_candidate</data><data key="display">絶対化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.7:C4" target="t:絶対化" id="e781"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.7:C4" target="t:残差" id="e782"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.7:C4" target="t:意味" id="e783"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.7:C4" target="f:として" id="e784"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:8.7:C4" target="f:とする" id="e785"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:8.8:C4"><data key="node_type">sentence</data><data key="display">照合の過剰は、残差保持ではなく、残差の意味強制になる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L311:C4</data><data key="split">tune</data></node><edge source="s:SAT:8.8:C4" target="t:照合" id="e786"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.8:C4" target="t:過剰" id="e787"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.8:C4" target="t:残差保持" id="e788"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:8.8:C4" target="t:残差" id="e789"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:意味強制"><data key="node_type">term_candidate</data><data key="display">意味強制</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:8.8:C4" target="t:意味強制" id="e790"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:9.1:C4"><data key="node_type">sentence</data><data key="display">知は、同期と照合だけでは閉じない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L317:C4</data><data key="split">register</data></node><edge source="s:SAT:9.1:C4" target="t:知" id="e791"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.1:C4" target="t:同期" id="e792"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.1:C4" target="t:照合" id="e793"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:9.2:C4"><data key="node_type">sentence</data><data key="display">同期は、内部ヒューリスティックと外部ヒューリスティックの運用的一致を与える。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L319:C4</data><data key="split">tune</data></node><edge source="s:SAT:9.2:C4" target="t:同期" id="e794"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.2:C4" target="t:内部" id="e795"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.2:C4" target="t:ヒューリスティック" id="e796"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.2:C4" target="t:外部" id="e797"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:運用的一致"><data key="node_type">term_candidate</data><data key="display">運用的一致</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.2:C4" target="t:運用的一致" id="e798"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:9.3:C4"><data key="node_type">sentence</data><data key="display">照合は、その一致・不一致・残差に意味を与える。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L321:C4</data><data key="split">test</data></node><edge source="s:SAT:9.3:C4" target="t:照合" id="e799"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.3:C4" target="t:一致" id="e800"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.3:C4" target="t:不一致" id="e801"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.3:C4" target="t:残差" id="e802"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.3:C4" target="t:意味" id="e803"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:9.4:C4"><data key="node_type">sentence</data><data key="display">しかし、照合されたもののすべてが閉じられるわけではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L323:C4</data><data key="split">register</data></node><edge source="s:SAT:9.4:C4" target="t:照合" id="e804"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.4:C4" target="f:しかし" id="e805"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.4:C4" target="f:ではない" id="e806"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.4.1:C6"><data key="node_type">sentence</data><data key="display">閉じられなかったものは、残差として残る。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L325:C6</data><data key="split">test</data></node><edge source="s:SAT:9.4.1:C6" target="t:残差" id="e807"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.4.1:C6" target="f:として" id="e808"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.5:C4"><data key="node_type">sentence</data><data key="display">残差とは、単なる未解決問題ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L327:C4</data><data key="split">register</data></node><edge source="s:SAT:9.5:C4" target="t:残差" id="e809"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未解決問題"><data key="node_type">term_candidate</data><data key="display">未解決問題</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5:C4" target="t:未解決問題" id="e810"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5:C4" target="f:とは" id="e811"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.5:C4" target="f:ではない" id="e812"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.5.1:C6"><data key="node_type">sentence</data><data key="display">残差とは、同期・照合・分類・観測の過程で現れる、まだ再照合可能な差分である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L329:C6</data><data key="split">register</data></node><edge source="s:SAT:9.5.1:C6" target="t:残差" id="e813"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.1:C6" target="t:同期" id="e814"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.1:C6" target="t:照合" id="e815"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.1:C6" target="t:分類" id="e816"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.1:C6" target="t:観測" id="e817"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.1:C6" target="t:過程" id="e818"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:再照合可能"><data key="node_type">term_candidate</data><data key="display">再照合可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.1:C6" target="t:再照合可能" id="e819"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:差分"><data key="node_type">term_candidate</data><data key="display">差分</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.1:C6" target="t:差分" id="e820"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.1:C6" target="f:とは" id="e821"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.5.1:C6" target="f:である" id="e822"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.5.2:C6"><data key="node_type">sentence</data><data key="display">残渣とは、処理・分類・制度化・交換・説明のあとに残り、しばしば不可視化されながらも、なお場に作用し続ける履歴的沈殿である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L331:C6</data><data key="split">register</data></node><node id="t:残渣"><data key="node_type">term_candidate</data><data key="display">残渣</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.2:C6" target="t:残渣" id="e823"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.2:C6" target="t:処理" id="e824"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.2:C6" target="t:分類" id="e825"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:制度化"><data key="node_type">term_candidate</data><data key="display">制度化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.2:C6" target="t:制度化" id="e826"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:交換"><data key="node_type">term_candidate</data><data key="display">交換</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.2:C6" target="t:交換" id="e827"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.2:C6" target="t:説明" id="e828"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.2:C6" target="t:不可視化" id="e829"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.2:C6" target="t:作用" id="e830"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:履歴的沈殿"><data key="node_type">term_candidate</data><data key="display">履歴的沈殿</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.2:C6" target="t:履歴的沈殿" id="e831"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.2:C6" target="f:とは" id="e832"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.5.2:C6" target="f:である" id="e833"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.5.3:C6"><data key="node_type">sentence</data><data key="display">残差は、問いとして保持される。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L333:C6</data><data key="split">register</data></node><edge source="s:SAT:9.5.3:C6" target="t:残差" id="e834"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.3:C6" target="t:保持" id="e835"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.3:C6" target="f:として" id="e836"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.5.4:C6"><data key="node_type">sentence</data><data key="display">残渣は、負債・違和感・汚染・歪み・意味圧として蓄積する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L335:C6</data><data key="split">register</data></node><edge source="s:SAT:9.5.4:C6" target="t:残渣" id="e837"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:負債"><data key="node_type">term_candidate</data><data key="display">負債</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.4:C6" target="t:負債" id="e838"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.4:C6" target="t:違和感" id="e839"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:汚染"><data key="node_type">term_candidate</data><data key="display">汚染</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.4:C6" target="t:汚染" id="e840"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.4:C6" target="t:意味圧" id="e841"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:蓄積"><data key="node_type">term_candidate</data><data key="display">蓄積</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.5.4:C6" target="t:蓄積" id="e842"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.5.4:C6" target="f:として" id="e843"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.6:C4"><data key="node_type">sentence</data><data key="display">残差は、観測・意味化・分類・制度化・記録・交換・説明の過程で、処理されず、または処理されたことにされながら、なお場に作用し続けることがある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L337:C4</data><data key="split">tune</data></node><edge source="s:SAT:9.6:C4" target="t:残差" id="e844"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6:C4" target="t:観測" id="e845"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:意味化"><data key="node_type">term_candidate</data><data key="display">意味化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6:C4" target="t:意味化" id="e846"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6:C4" target="t:分類" id="e847"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6:C4" target="t:制度化" id="e848"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:記録"><data key="node_type">term_candidate</data><data key="display">記録</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6:C4" target="t:記録" id="e849"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6:C4" target="t:交換" id="e850"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6:C4" target="t:説明" id="e851"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6:C4" target="t:過程" id="e852"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6:C4" target="t:処理" id="e853"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6:C4" target="t:作用" id="e854"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:9.6.1:C6"><data key="node_type">sentence</data><data key="display">残差は、見落としである場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L339:C6</data><data key="split">test</data></node><edge source="s:SAT:9.6.1:C6" target="t:残差" id="e855"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:見落"><data key="node_type">term_candidate</data><data key="display">見落</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6.1:C6" target="t:見落" id="e856"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.1:C6" target="t:場合" id="e857"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.1:C6" target="f:である" id="e858"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.6.2:C6"><data key="node_type">sentence</data><data key="display">残差は、抑圧である場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L341:C6</data><data key="split">test</data></node><edge source="s:SAT:9.6.2:C6" target="t:残差" id="e859"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:抑圧"><data key="node_type">term_candidate</data><data key="display">抑圧</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6.2:C6" target="t:抑圧" id="e860"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.2:C6" target="t:場合" id="e861"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.2:C6" target="f:である" id="e862"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.6.3:C6"><data key="node_type">sentence</data><data key="display">残差は、外部化された負債である場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L343:C6</data><data key="split">register</data></node><edge source="s:SAT:9.6.3:C6" target="t:残差" id="e863"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.3:C6" target="t:外部化" id="e864"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.3:C6" target="t:負債" id="e865"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.3:C6" target="t:場合" id="e866"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.3:C6" target="f:である" id="e867"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.6.4:C6"><data key="node_type">sentence</data><data key="display">残差は、未来の問いの発生源である場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L345:C6</data><data key="split">register</data></node><edge source="s:SAT:9.6.4:C6" target="t:残差" id="e868"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未来"><data key="node_type">term_candidate</data><data key="display">未来</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6.4:C6" target="t:未来" id="e869"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.4:C6" target="t:発生源" id="e870"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.4:C6" target="t:場合" id="e871"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.4:C6" target="f:である" id="e872"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.6.5:C6"><data key="node_type">sentence</data><data key="display">残差は、現在の同期体系では照合不能な意味張力である場合がある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L347:C6</data><data key="split">register</data></node><edge source="s:SAT:9.6.5:C6" target="t:残差" id="e873"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:現在"><data key="node_type">term_candidate</data><data key="display">現在</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6.5:C6" target="t:現在" id="e874"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:同期体系"><data key="node_type">term_candidate</data><data key="display">同期体系</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6.5:C6" target="t:同期体系" id="e875"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:照合不能"><data key="node_type">term_candidate</data><data key="display">照合不能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6.5:C6" target="t:照合不能" id="e876"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:意味張力"><data key="node_type">term_candidate</data><data key="display">意味張力</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.6.5:C6" target="t:意味張力" id="e877"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.5:C6" target="t:場合" id="e878"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.6.5:C6" target="f:である" id="e879"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.7:C4"><data key="node_type">sentence</data><data key="display">したがって、残差を即座に廃棄してはならない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L349:C4</data><data key="split">register</data></node><edge source="s:SAT:9.7:C4" target="t:残差" id="e880"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:即座"><data key="node_type">term_candidate</data><data key="display">即座</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.7:C4" target="t:即座" id="e881"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:廃棄"><data key="node_type">term_candidate</data><data key="display">廃棄</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.7:C4" target="t:廃棄" id="e882"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.7:C4" target="f:したがって" id="e883"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.8:C4"><data key="node_type">sentence</data><data key="display">しかし、残差をすべて保持してもならない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L351:C4</data><data key="split">register</data></node><edge source="s:SAT:9.8:C4" target="t:残差" id="e884"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.8:C4" target="t:保持" id="e885"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.8:C4" target="f:しかし" id="e886"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.9:C4"><data key="node_type">sentence</data><data key="display">すべての残差を保持することは、認識をカオスへ戻す。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L353:C4</data><data key="split">register</data></node><edge source="s:SAT:9.9:C4" target="t:残差" id="e887"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.9:C4" target="t:保持" id="e888"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.9:C4" target="t:認識" id="e889"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:カオス"><data key="node_type">term_candidate</data><data key="display">カオス</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.9:C4" target="t:カオス" id="e890"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.9:C4" target="f:保持する" id="e891"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.9:C4" target="f:とは" id="e892"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.10:C5"><data key="node_type">sentence</data><data key="display">残差保持とは、残差を閉じず、捨てず、かつ無制限に氾濫させないための境界操作である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L355:C5</data><data key="split">register</data></node><edge source="s:SAT:9.10:C5" target="t:残差保持" id="e893"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.10:C5" target="t:残差" id="e894"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:無制限"><data key="node_type">term_candidate</data><data key="display">無制限</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.10:C5" target="t:無制限" id="e895"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:氾濫"><data key="node_type">term_candidate</data><data key="display">氾濫</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.10:C5" target="t:氾濫" id="e896"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:境界操作"><data key="node_type">term_candidate</data><data key="display">境界操作</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.10:C5" target="t:境界操作" id="e897"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.10:C5" target="f:とは" id="e898"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.10:C5" target="f:である" id="e899"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.11:C5"><data key="node_type">sentence</data><data key="display">新しいヒューリスティックは、しばしば残差保持と再照合の結果として発生する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L357:C5</data><data key="split">test</data></node><edge source="s:SAT:9.11:C5" target="t:ヒューリスティック" id="e900"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.11:C5" target="t:残差保持" id="e901"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:再照合"><data key="node_type">term_candidate</data><data key="display">再照合</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.11:C5" target="t:再照合" id="e902"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:結果"><data key="node_type">term_candidate</data><data key="display">結果</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.11:C5" target="t:結果" id="e903"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.11:C5" target="t:発生" id="e904"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.11:C5" target="f:として" id="e905"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.11.1:C7"><data key="node_type">sentence</data><data key="display">創発とは、無からの出現ではなく、既存の分類体系で閉じられなかった残差が、再照合によって新しい分類形式を要求することである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L359:C7</data><data key="split">tune</data></node><node id="t:創発"><data key="node_type">term_candidate</data><data key="display">創発</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.11.1:C7" target="t:創発" id="e906"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:無"><data key="node_type">term_candidate</data><data key="display">無</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.11.1:C7" target="t:無" id="e907"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:出現"><data key="node_type">term_candidate</data><data key="display">出現</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.11.1:C7" target="t:出現" id="e908"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:既存"><data key="node_type">term_candidate</data><data key="display">既存</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.11.1:C7" target="t:既存" id="e909"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分類体系"><data key="node_type">term_candidate</data><data key="display">分類体系</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.11.1:C7" target="t:分類体系" id="e910"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.11.1:C7" target="t:残差" id="e911"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.11.1:C7" target="t:再照合" id="e912"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.11.1:C7" target="t:分類形式" id="e913"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.11.1:C7" target="t:要求" id="e914"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.11.1:C7" target="f:とは" id="e915"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.11.1:C7" target="f:によって" id="e916"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.11.1:C7" target="f:である" id="e917"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.12:C5"><data key="node_type">sentence</data><data key="display">嘘とは、単なる偽命題ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L361:C5</data><data key="split">register</data></node><node id="t:偽命題"><data key="node_type">term_candidate</data><data key="display">偽命題</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.12:C5" target="t:偽命題" id="e918"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.12:C5" target="f:とは" id="e919"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.12:C5" target="f:ではない" id="e920"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.12.1:C7"><data key="node_type">sentence</data><data key="display">嘘とは、照合経路を切断し、残差へのアクセスを塞ぐ操作である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L363:C7</data><data key="split">register</data></node><node id="t:照合経路"><data key="node_type">term_candidate</data><data key="display">照合経路</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.12.1:C7" target="t:照合経路" id="e921"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.12.1:C7" target="t:切断" id="e922"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.12.1:C7" target="t:残差" id="e923"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:アクセス"><data key="node_type">term_candidate</data><data key="display">アクセス</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.12.1:C7" target="t:アクセス" id="e924"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.12.1:C7" target="t:操作" id="e925"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.12.1:C7" target="f:とは" id="e926"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.12.1:C7" target="f:である" id="e927"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.13:C5"><data key="node_type">sentence</data><data key="display">搾取とは、制度上の同期を維持しながら、負荷・責任・痛み・未来機会を残差として外部化する操作である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L365:C5</data><data key="split">register</data></node><node id="t:搾取"><data key="node_type">term_candidate</data><data key="display">搾取</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.13:C5" target="t:搾取" id="e928"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:制度上"><data key="node_type">term_candidate</data><data key="display">制度上</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.13:C5" target="t:制度上" id="e929"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="t:同期" id="e930"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="t:維持" id="e931"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:負荷"><data key="node_type">term_candidate</data><data key="display">負荷</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.13:C5" target="t:負荷" id="e932"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="t:責任" id="e933"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未来機会"><data key="node_type">term_candidate</data><data key="display">未来機会</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.13:C5" target="t:未来機会" id="e934"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="t:残差" id="e935"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="t:外部化" id="e936"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="t:操作" id="e937"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="f:とは" id="e938"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="f:しながら" id="e939"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="f:として" id="e940"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.13:C5" target="f:である" id="e941"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.14:C5"><data key="node_type">sentence</data><data key="display">環境問題とは、経済的同期から排除された自然・身体・未来世代の残渣が、場の反応として戻ってくる問題である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L367:C5</data><data key="split">test</data></node><node id="t:環境問題"><data key="node_type">term_candidate</data><data key="display">環境問題</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.14:C5" target="t:環境問題" id="e942"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:経済的同期"><data key="node_type">term_candidate</data><data key="display">経済的同期</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.14:C5" target="t:経済的同期" id="e943"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:排除"><data key="node_type">term_candidate</data><data key="display">排除</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.14:C5" target="t:排除" id="e944"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:自然"><data key="node_type">term_candidate</data><data key="display">自然</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.14:C5" target="t:自然" id="e945"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:身体"><data key="node_type">term_candidate</data><data key="display">身体</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.14:C5" target="t:身体" id="e946"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未来世代"><data key="node_type">term_candidate</data><data key="display">未来世代</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.14:C5" target="t:未来世代" id="e947"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.14:C5" target="t:残渣" id="e948"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.14:C5" target="t:反応" id="e949"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:問題"><data key="node_type">term_candidate</data><data key="display">問題</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.14:C5" target="t:問題" id="e950"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.14:C5" target="f:とは" id="e951"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.14:C5" target="f:として" id="e952"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.14:C5" target="f:である" id="e953"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.15:C5"><data key="node_type">sentence</data><data key="display">AIの偽閉鎖とは、未解決残差を回答形式で閉じたように見せることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L369:C5</data><data key="split">test</data></node><edge source="s:SAT:9.15:C5" target="t:AI" id="e954"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.15:C5" target="t:偽閉鎖" id="e955"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未解決残差"><data key="node_type">term_candidate</data><data key="display">未解決残差</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.15:C5" target="t:未解決残差" id="e956"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:回答形式"><data key="node_type">term_candidate</data><data key="display">回答形式</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.15:C5" target="t:回答形式" id="e957"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.15:C5" target="f:とは" id="e958"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.15:C5" target="f:である" id="e959"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.15.1:C7"><data key="node_type">sentence</data><data key="display">有用なAIは、残差を消すのではなく、残差へのアクセス経路を保つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L371:C7</data><data key="split">register</data></node><edge source="s:SAT:9.15.1:C7" target="t:有用" id="e960"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.15.1:C7" target="t:AI" id="e961"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.15.1:C7" target="t:残差" id="e962"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.15.1:C7" target="t:アクセス" id="e963"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:経路"><data key="node_type">term_candidate</data><data key="display">経路</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.15.1:C7" target="t:経路" id="e964"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:9.16:C5"><data key="node_type">sentence</data><data key="display">境界認識批判の中心は、すべてを観測することではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L373:C5</data><data key="split">register</data></node><edge source="s:SAT:9.16:C5" target="t:境界認識批判" id="e965"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:中心"><data key="node_type">term_candidate</data><data key="display">中心</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.16:C5" target="t:中心" id="e966"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.16:C5" target="t:観測" id="e967"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.16:C5" target="f:ではない" id="e968"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.16.1:C7"><data key="node_type">sentence</data><data key="display">境界認識批判の中心は、観測できないもの、観測されなかったもの、観測した瞬間に変質するもの、観測体系から漏れるものを、残差として扱う条件を問うことである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L375:C7</data><data key="split">register</data></node><edge source="s:SAT:9.16.1:C7" target="t:境界認識批判" id="e969"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.16.1:C7" target="t:中心" id="e970"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.16.1:C7" target="t:観測" id="e971"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:瞬間"><data key="node_type">term_candidate</data><data key="display">瞬間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.16.1:C7" target="t:瞬間" id="e972"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:変質"><data key="node_type">term_candidate</data><data key="display">変質</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.16.1:C7" target="t:変質" id="e973"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:観測体系"><data key="node_type">term_candidate</data><data key="display">観測体系</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:9.16.1:C7" target="t:観測体系" id="e974"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.16.1:C7" target="t:残差" id="e975"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.16.1:C7" target="t:条件" id="e976"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.16.1:C7" target="f:できない" id="e977"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.16.1:C7" target="f:として" id="e978"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.16.1:C7" target="f:問う" id="e979"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.16.1:C7" target="f:である" id="e980"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.17:C5"><data key="node_type">sentence</data><data key="display">知るとは、残差を消し切ることではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L377:C5</data><data key="split">register</data></node><edge source="s:SAT:9.17:C5" target="t:知" id="e981"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.17:C5" target="t:残差" id="e982"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.17:C5" target="f:とは" id="e983"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.17:C5" target="f:ではない" id="e984"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:9.17.1:C7"><data key="node_type">sentence</data><data key="display">知るとは、残差を保持したまま、判断可能性を維持することである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L379:C7</data><data key="split">register</data></node><edge source="s:SAT:9.17.1:C7" target="t:知" id="e985"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.17.1:C7" target="t:残差" id="e986"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.17.1:C7" target="t:保持" id="e987"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.17.1:C7" target="t:判断可能性" id="e988"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.17.1:C7" target="t:維持" id="e989"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:9.17.1:C7" target="f:とは" id="e990"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:9.17.1:C7" target="f:である" id="e991"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.1:C5"><data key="node_type">sentence</data><data key="display">命題は、単に真か偽かでは終わらない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L385:C5</data><data key="split">register</data></node><node id="t:命題"><data key="node_type">term_candidate</data><data key="display">命題</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.1:C5" target="t:命題" id="e992"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:偽"><data key="node_type">term_candidate</data><data key="display">偽</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.1:C5" target="t:偽" id="e993"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:10.2:C5"><data key="node_type">sentence</data><data key="display">命題は、どの場で真なのかを持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L387:C5</data><data key="split">register</data></node><edge source="s:SAT:10.2:C5" target="t:命題" id="e994"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:10.2.1:C7"><data key="node_type">sentence</data><data key="display">命題は、どの条件で真なのかを持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L389:C7</data><data key="split">register</data></node><edge source="s:SAT:10.2.1:C7" target="t:命題" id="e995"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.2.1:C7" target="t:条件" id="e996"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:10.2.2:C7"><data key="node_type">sentence</data><data key="display">命題は、どの外部ヒューリスティックと同期しているのかを持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L391:C7</data><data key="split">tune</data></node><edge source="s:SAT:10.2.2:C7" target="t:命題" id="e997"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.2.2:C7" target="t:外部" id="e998"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.2.2:C7" target="t:ヒューリスティック" id="e999"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.2.2:C7" target="t:同期" id="e1000"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:10.2.3:C7"><data key="node_type">sentence</data><data key="display">命題は、どの内部ヒューリスティックを起動しているのかを持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L393:C7</data><data key="split">register</data></node><edge source="s:SAT:10.2.3:C7" target="t:命題" id="e1001"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.2.3:C7" target="t:内部" id="e1002"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.2.3:C7" target="t:ヒューリスティック" id="e1003"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:起動"><data key="node_type">term_candidate</data><data key="display">起動</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.2.3:C7" target="t:起動" id="e1004"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:10.3:C5"><data key="node_type">sentence</data><data key="display">命題は、何を残差として残しているのかを持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L395:C5</data><data key="split">register</data></node><edge source="s:SAT:10.3:C5" target="t:命題" id="e1005"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.3:C5" target="t:残差" id="e1006"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.3:C5" target="f:として" id="e1007"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.4:C5"><data key="node_type">sentence</data><data key="display">したがって、真偽命題は意味論を持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L397:C5</data><data key="split">register</data></node><node id="t:真偽命題"><data key="node_type">term_candidate</data><data key="display">真偽命題</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.4:C5" target="t:真偽命題" id="e1008"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:意味論"><data key="node_type">term_candidate</data><data key="display">意味論</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.4:C5" target="t:意味論" id="e1009"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.4:C5" target="f:したがって" id="e1010"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.5:C5"><data key="node_type">sentence</data><data key="display">真とは、命題が事実に単純対応することだけではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L399:C5</data><data key="split">register</data></node><edge source="s:SAT:10.5:C5" target="t:命題" id="e1011"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:事実"><data key="node_type">term_candidate</data><data key="display">事実</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.5:C5" target="t:事実" id="e1012"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5:C5" target="t:単純対応" id="e1013"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5:C5" target="f:とは" id="e1014"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:10.5:C5" target="f:ではない" id="e1015"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.5.1:C7"><data key="node_type">sentence</data><data key="display">真とは、ある命題が、特定の履歴場において、特定の外部ヒューリスティックと照合され、判断可能性を保つ状態である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L401:C7</data><data key="split">register</data></node><edge source="s:SAT:10.5.1:C7" target="t:命題" id="e1016"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:特定"><data key="node_type">term_candidate</data><data key="display">特定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.5.1:C7" target="t:特定" id="e1017"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="t:履歴場" id="e1018"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="t:外部" id="e1019"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="t:ヒューリスティック" id="e1020"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="t:照合" id="e1021"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="t:判断可能性" id="e1022"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="t:状態" id="e1023"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="f:とは" id="e1024"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="f:において" id="e1025"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:10.5.1:C7" target="f:である" id="e1026"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.6:C5"><data key="node_type">sentence</data><data key="display">偽とは、単なる不一致ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L403:C5</data><data key="split">test</data></node><edge source="s:SAT:10.6:C5" target="t:偽" id="e1027"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.6:C5" target="t:不一致" id="e1028"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.6:C5" target="f:とは" id="e1029"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:10.6:C5" target="f:ではない" id="e1030"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.6.1:C7"><data key="node_type">sentence</data><data key="display">偽とは、同期不能、照合不能、適用範囲逸脱、分類失敗、または偽閉鎖として現れる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L405:C7</data><data key="split">tune</data></node><edge source="s:SAT:10.6.1:C7" target="t:偽" id="e1031"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:同期不能"><data key="node_type">term_candidate</data><data key="display">同期不能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.6.1:C7" target="t:同期不能" id="e1032"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.6.1:C7" target="t:照合不能" id="e1033"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:適用範囲逸脱"><data key="node_type">term_candidate</data><data key="display">適用範囲逸脱</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.6.1:C7" target="t:適用範囲逸脱" id="e1034"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:分類失敗"><data key="node_type">term_candidate</data><data key="display">分類失敗</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.6.1:C7" target="t:分類失敗" id="e1035"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.6.1:C7" target="t:偽閉鎖" id="e1036"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.6.1:C7" target="f:とは" id="e1037"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:10.6.1:C7" target="f:として" id="e1038"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.7:C5"><data key="node_type">sentence</data><data key="display">未解決とは、偽ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L407:C5</data><data key="split">register</data></node><edge source="s:SAT:10.7:C5" target="t:未解決" id="e1039"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.7:C5" target="t:偽" id="e1040"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.7:C5" target="f:とは" id="e1041"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:10.7:C5" target="f:ではない" id="e1042"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.7.1:C7"><data key="node_type">sentence</data><data key="display">未解決とは、照合が閉じていない状態である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L409:C7</data><data key="split">register</data></node><edge source="s:SAT:10.7.1:C7" target="t:未解決" id="e1043"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.7.1:C7" target="t:照合" id="e1044"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.7.1:C7" target="t:状態" id="e1045"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.7.1:C7" target="f:とは" id="e1046"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:10.7.1:C7" target="f:である" id="e1047"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.8:C5"><data key="node_type">sentence</data><data key="display">知にとって重要なのは、真偽だけでなく、真偽・意味・残差・更新可能性の配置である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L411:C5</data><data key="split">register</data></node><edge source="s:SAT:10.8:C5" target="t:知" id="e1048"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.8:C5" target="t:重要" id="e1049"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:真偽"><data key="node_type">term_candidate</data><data key="display">真偽</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.8:C5" target="t:真偽" id="e1050"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.8:C5" target="t:意味" id="e1051"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.8:C5" target="t:残差" id="e1052"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:更新可能性"><data key="node_type">term_candidate</data><data key="display">更新可能性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.8:C5" target="t:更新可能性" id="e1053"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:配置"><data key="node_type">term_candidate</data><data key="display">配置</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.8:C5" target="t:配置" id="e1054"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.8:C5" target="f:だけでなく" id="e1055"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:10.8:C5" target="f:である" id="e1056"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:10.9:C5"><data key="node_type">sentence</data><data key="display">真偽判定から残差へのアクセス経路を切断すると、命題は制度的には機能しても、意味論的には劣化する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L413:C5</data><data key="split">test</data></node><node id="t:真偽判定"><data key="node_type">term_candidate</data><data key="display">真偽判定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.9:C5" target="t:真偽判定" id="e1057"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.9:C5" target="t:残差" id="e1058"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.9:C5" target="t:アクセス" id="e1059"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.9:C5" target="t:経路" id="e1060"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.9:C5" target="t:切断" id="e1061"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.9:C5" target="t:命題" id="e1062"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:制度的"><data key="node_type">term_candidate</data><data key="display">制度的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.9:C5" target="t:制度的" id="e1063"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:10.9:C5" target="t:機能" id="e1064"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:意味論的"><data key="node_type">term_candidate</data><data key="display">意味論的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.9:C5" target="t:意味論的" id="e1065"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:劣化"><data key="node_type">term_candidate</data><data key="display">劣化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:10.9:C5" target="t:劣化" id="e1066"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:11.1:C5"><data key="node_type">sentence</data><data key="display">学問とは、知識の保管庫ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L419:C5</data><data key="split">register</data></node><node id="t:学問"><data key="node_type">term_candidate</data><data key="display">学問</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.1:C5" target="t:学問" id="e1067"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:知識"><data key="node_type">term_candidate</data><data key="display">知識</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.1:C5" target="t:知識" id="e1068"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:保管庫"><data key="node_type">term_candidate</data><data key="display">保管庫</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.1:C5" target="t:保管庫" id="e1069"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.1:C5" target="f:とは" id="e1070"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:11.1:C5" target="f:ではない" id="e1071"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.2:C5"><data key="node_type">sentence</data><data key="display">学問とは、内部ヒューリスティックと外部ヒューリスティックの同期を試みる営みである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L421:C5</data><data key="split">register</data></node><edge source="s:SAT:11.2:C5" target="t:学問" id="e1072"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2:C5" target="t:内部" id="e1073"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2:C5" target="t:ヒューリスティック" id="e1074"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2:C5" target="t:外部" id="e1075"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2:C5" target="t:同期" id="e1076"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2:C5" target="f:とは" id="e1077"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:11.2:C5" target="f:である" id="e1078"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.2.1:C7"><data key="node_type">sentence</data><data key="display">ただし、同期だけでは学問にならない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L423:C7</data><data key="split">register</data></node><edge source="s:SAT:11.2.1:C7" target="t:同期" id="e1079"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1:C7" target="t:学問" id="e1080"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1:C7" target="f:ただし" id="e1081"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.2.1.1:C9"><data key="node_type">sentence</data><data key="display">学問は、同期の一致・不一致・残差を照合する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L425:C9</data><data key="split">test</data></node><edge source="s:SAT:11.2.1.1:C9" target="t:学問" id="e1082"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.1:C9" target="t:同期" id="e1083"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.1:C9" target="t:一致" id="e1084"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.1:C9" target="t:不一致" id="e1085"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.1:C9" target="t:残差" id="e1086"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.1:C9" target="t:照合" id="e1087"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:照合する"><data key="node_type">expression_candidate</data><data key="display">照合する</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.2.1.1:C9" target="f:照合する" id="e1088"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.2.1.2:C9"><data key="node_type">sentence</data><data key="display">学問は、その照合手順を言語化する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L427:C9</data><data key="split">register</data></node><edge source="s:SAT:11.2.1.2:C9" target="t:学問" id="e1089"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:照合手順"><data key="node_type">term_candidate</data><data key="display">照合手順</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.2.1.2:C9" target="t:照合手順" id="e1090"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:言語化"><data key="node_type">term_candidate</data><data key="display">言語化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.2.1.2:C9" target="t:言語化" id="e1091"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:11.2.1.3:C9"><data key="node_type">sentence</data><data key="display">学問は、その照合手順を記号化する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L429:C9</data><data key="split">register</data></node><edge source="s:SAT:11.2.1.3:C9" target="t:学問" id="e1092"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.3:C9" target="t:照合手順" id="e1093"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:記号化"><data key="node_type">term_candidate</data><data key="display">記号化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.2.1.3:C9" target="t:記号化" id="e1094"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:11.2.1.4:C9"><data key="node_type">sentence</data><data key="display">学問は、その照合手順を方法化する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L431:C9</data><data key="split">register</data></node><edge source="s:SAT:11.2.1.4:C9" target="t:学問" id="e1095"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.4:C9" target="t:照合手順" id="e1096"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:方法化"><data key="node_type">term_candidate</data><data key="display">方法化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.2.1.4:C9" target="t:方法化" id="e1097"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:11.2.1.5:C9"><data key="node_type">sentence</data><data key="display">学問は、その照合手順を他者が再照合できる形へ保存する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L433:C9</data><data key="split">register</data></node><edge source="s:SAT:11.2.1.5:C9" target="t:学問" id="e1098"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.5:C9" target="t:照合手順" id="e1099"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.5:C9" target="t:他者" id="e1100"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.2.1.5:C9" target="t:再照合" id="e1101"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:保存"><data key="node_type">term_candidate</data><data key="display">保存</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.2.1.5:C9" target="t:保存" id="e1102"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:11.3:C5"><data key="node_type">sentence</data><data key="display">したがって、学問とは、同期と照合の継承可能な形式である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L435:C5</data><data key="split">register</data></node><edge source="s:SAT:11.3:C5" target="t:学問" id="e1103"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3:C5" target="t:同期" id="e1104"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3:C5" target="t:照合" id="e1105"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:継承可能"><data key="node_type">term_candidate</data><data key="display">継承可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3:C5" target="t:継承可能" id="e1106"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:形式"><data key="node_type">term_candidate</data><data key="display">形式</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3:C5" target="t:形式" id="e1107"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3:C5" target="f:したがって" id="e1108"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:11.3:C5" target="f:とは" id="e1109"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:11.3:C5" target="f:である" id="e1110"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.3.1:C7"><data key="node_type">sentence</data><data key="display">科学は、外部同期と再照合の強度が高い学問形式である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L437:C7</data><data key="split">register</data></node><edge source="s:SAT:11.3.1:C7" target="t:科学" id="e1111"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.1:C7" target="t:外部同期" id="e1112"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.1:C7" target="t:再照合" id="e1113"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:強度"><data key="node_type">term_candidate</data><data key="display">強度</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3.1:C7" target="t:強度" id="e1114"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:学問形式"><data key="node_type">term_candidate</data><data key="display">学問形式</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3.1:C7" target="t:学問形式" id="e1115"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.1:C7" target="f:である" id="e1116"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.3.2:C7"><data key="node_type">sentence</data><data key="display">哲学は、同期と照合の成立条件そのものを問う学問形式である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L439:C7</data><data key="split">register</data></node><node id="t:哲学"><data key="node_type">term_candidate</data><data key="display">哲学</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3.2:C7" target="t:哲学" id="e1117"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.2:C7" target="t:同期" id="e1118"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.2:C7" target="t:照合" id="e1119"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.2:C7" target="t:成立条件" id="e1120"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.2:C7" target="t:学問形式" id="e1121"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.2:C7" target="f:問う" id="e1122"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:11.3.2:C7" target="f:である" id="e1123"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.3.3:C7"><data key="node_type">sentence</data><data key="display">形而上学は、入力・対象・意味・判断・存在が立ち上がる以前の条件を問う学問形式である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L441:C7</data><data key="split">register</data></node><node id="t:形而上学"><data key="node_type">term_candidate</data><data key="display">形而上学</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3.3:C7" target="t:形而上学" id="e1124"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="t:入力" id="e1125"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="t:対象" id="e1126"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="t:意味" id="e1127"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="t:判断" id="e1128"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="t:存在" id="e1129"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:以前"><data key="node_type">term_candidate</data><data key="display">以前</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3.3:C7" target="t:以前" id="e1130"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="t:条件" id="e1131"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="t:学問形式" id="e1132"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="f:問う" id="e1133"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:11.3.3:C7" target="f:である" id="e1134"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.3.4:C7"><data key="node_type">sentence</data><data key="display">人文学は、履歴場における意味・解釈・言語ゲーム・価値の照合を扱う学問形式である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L443:C7</data><data key="split">tune</data></node><node id="t:人文学"><data key="node_type">term_candidate</data><data key="display">人文学</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3.4:C7" target="t:人文学" id="e1135"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.4:C7" target="t:履歴場" id="e1136"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.4:C7" target="t:意味" id="e1137"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:解釈"><data key="node_type">term_candidate</data><data key="display">解釈</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3.4:C7" target="t:解釈" id="e1138"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.4:C7" target="t:言語" id="e1139"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:ゲーム"><data key="node_type">term_candidate</data><data key="display">ゲーム</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.3.4:C7" target="t:ゲーム" id="e1140"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.4:C7" target="t:価値" id="e1141"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.4:C7" target="t:照合" id="e1142"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.4:C7" target="t:学問形式" id="e1143"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.3.4:C7" target="f:である" id="e1144"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.4:C5"><data key="node_type">sentence</data><data key="display">AI時代の学問は、外部記憶を内部理解へ同期し、その照合過程を人間が保持できるかを問われる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L445:C5</data><data key="split">register</data></node><edge source="s:SAT:11.4:C5" target="t:AI" id="e1145"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:時代"><data key="node_type">term_candidate</data><data key="display">時代</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.4:C5" target="t:時代" id="e1146"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.4:C5" target="t:学問" id="e1147"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:外部記憶"><data key="node_type">term_candidate</data><data key="display">外部記憶</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.4:C5" target="t:外部記憶" id="e1148"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:内部理解"><data key="node_type">term_candidate</data><data key="display">内部理解</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.4:C5" target="t:内部理解" id="e1149"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.4:C5" target="t:同期" id="e1150"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:照合過程"><data key="node_type">term_candidate</data><data key="display">照合過程</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.4:C5" target="t:照合過程" id="e1151"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:人間"><data key="node_type">term_candidate</data><data key="display">人間</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:11.4:C5" target="t:人間" id="e1152"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.4:C5" target="t:保持" id="e1153"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:11.5:C5"><data key="node_type">sentence</data><data key="display">学問は、残差を消し切るための制度ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L447:C5</data><data key="split">register</data></node><edge source="s:SAT:11.5:C5" target="t:学問" id="e1154"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5:C5" target="t:残差" id="e1155"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5:C5" target="t:制度" id="e1156"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5:C5" target="f:ではない" id="e1157"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:11.5.1:C7"><data key="node_type">sentence</data><data key="display">学問は、残差を再照合可能な形で保存し、未来の問いへ渡すための制度である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L449:C7</data><data key="split">register</data></node><edge source="s:SAT:11.5.1:C7" target="t:学問" id="e1158"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5.1:C7" target="t:残差" id="e1159"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5.1:C7" target="t:再照合可能" id="e1160"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5.1:C7" target="t:保存" id="e1161"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5.1:C7" target="t:未来" id="e1162"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5.1:C7" target="t:制度" id="e1163"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:11.5.1:C7" target="f:である" id="e1164"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.1:C5"><data key="node_type">sentence</data><data key="display">言語は、意味を運ぶだけではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L455:C5</data><data key="split">register</data></node><edge source="s:SAT:12.1:C5" target="t:言語" id="e1165"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.1:C5" target="t:意味" id="e1166"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.1:C5" target="f:ではない" id="e1167"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.2:C5"><data key="node_type">sentence</data><data key="display">言語は、分類を同期させる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L457:C5</data><data key="split">register</data></node><edge source="s:SAT:12.2:C5" target="t:言語" id="e1168"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.2:C5" target="t:分類" id="e1169"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.2:C5" target="t:同期" id="e1170"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:12.3:C5"><data key="node_type">sentence</data><data key="display">言語は、反応を同期させる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L459:C5</data><data key="split">register</data></node><edge source="s:SAT:12.3:C5" target="t:言語" id="e1171"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.3:C5" target="t:反応" id="e1172"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.3:C5" target="t:同期" id="e1173"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:12.4:C5"><data key="node_type">sentence</data><data key="display">言語は、責任を同期させる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L461:C5</data><data key="split">register</data></node><edge source="s:SAT:12.4:C5" target="t:言語" id="e1174"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.4:C5" target="t:責任" id="e1175"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.4:C5" target="t:同期" id="e1176"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:12.5:C5"><data key="node_type">sentence</data><data key="display">言語は、何を問題と呼び、何を説明と呼び、何を証明と呼び、何を冗談と呼び、何を失礼と呼ぶかを同期させる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L463:C5</data><data key="split">tune</data></node><edge source="s:SAT:12.5:C5" target="t:言語" id="e1177"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.5:C5" target="t:問題" id="e1178"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.5:C5" target="t:説明" id="e1179"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:証明"><data key="node_type">term_candidate</data><data key="display">証明</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.5:C5" target="t:証明" id="e1180"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:冗談"><data key="node_type">term_candidate</data><data key="display">冗談</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.5:C5" target="t:冗談" id="e1181"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:失礼"><data key="node_type">term_candidate</data><data key="display">失礼</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.5:C5" target="t:失礼" id="e1182"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.5:C5" target="t:同期" id="e1183"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:12.6:C5"><data key="node_type">sentence</data><data key="display">言語ゲームとは、共同体内で安定化した照合規則である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L465:C5</data><data key="split">register</data></node><edge source="s:SAT:12.6:C5" target="t:言語" id="e1184"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.6:C5" target="t:ゲーム" id="e1185"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.6:C5" target="t:共同体内" id="e1186"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:安定化"><data key="node_type">term_candidate</data><data key="display">安定化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.6:C5" target="t:安定化" id="e1187"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:照合規則"><data key="node_type">term_candidate</data><data key="display">照合規則</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.6:C5" target="t:照合規則" id="e1188"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.6:C5" target="f:とは" id="e1189"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:12.6:C5" target="f:である" id="e1190"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.7:C5"><data key="node_type">sentence</data><data key="display">言語ゲームが違えば、同じ命題でも異なる内部ヒューリスティックを起動する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L467:C5</data><data key="split">register</data></node><edge source="s:SAT:12.7:C5" target="t:言語" id="e1191"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.7:C5" target="t:ゲーム" id="e1192"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.7:C5" target="t:命題" id="e1193"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.7:C5" target="t:内部" id="e1194"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.7:C5" target="t:ヒューリスティック" id="e1195"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.7:C5" target="t:起動" id="e1196"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:12.8:C5"><data key="node_type">sentence</data><data key="display">したがって、誤解は単なる情報不足ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L469:C5</data><data key="split">register</data></node><node id="t:誤解"><data key="node_type">term_candidate</data><data key="display">誤解</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.8:C5" target="t:誤解" id="e1197"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:情報不足"><data key="node_type">term_candidate</data><data key="display">情報不足</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.8:C5" target="t:情報不足" id="e1198"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.8:C5" target="f:したがって" id="e1199"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:12.8:C5" target="f:ではない" id="e1200"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.8.1:C7"><data key="node_type">sentence</data><data key="display">誤解は、照合規則の不一致として発生する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L471:C7</data><data key="split">tune</data></node><edge source="s:SAT:12.8.1:C7" target="t:誤解" id="e1201"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.8.1:C7" target="t:照合規則" id="e1202"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.8.1:C7" target="t:不一致" id="e1203"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.8.1:C7" target="t:発生" id="e1204"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.8.1:C7" target="f:として" id="e1205"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.9:C5"><data key="node_type">sentence</data><data key="display">通約とは、異なる言語ゲームの間に照合可能な対応面を作ることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L473:C5</data><data key="split">tune</data></node><edge source="s:SAT:12.9:C5" target="t:通約" id="e1206"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9:C5" target="t:言語" id="e1207"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9:C5" target="t:ゲーム" id="e1208"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:照合可能"><data key="node_type">term_candidate</data><data key="display">照合可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.9:C5" target="t:照合可能" id="e1209"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:対応面"><data key="node_type">term_candidate</data><data key="display">対応面</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.9:C5" target="t:対応面" id="e1210"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9:C5" target="f:とは" id="e1211"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:12.9:C5" target="f:である" id="e1212"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.9.1:C7"><data key="node_type">sentence</data><data key="display">完全翻訳は不要である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L475:C7</data><data key="split">register</data></node><node id="t:完全翻訳"><data key="node_type">term_candidate</data><data key="display">完全翻訳</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.9.1:C7" target="t:完全翻訳" id="e1213"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:不要"><data key="node_type">term_candidate</data><data key="display">不要</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.9.1:C7" target="t:不要" id="e1214"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9.1:C7" target="f:である" id="e1215"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.9.2:C7"><data key="node_type">sentence</data><data key="display">必要なのは、保存すべき核、変換可能な層、未決定の残差を分けることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L477:C7</data><data key="split">register</data></node><edge source="s:SAT:12.9.2:C7" target="t:必要" id="e1216"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9.2:C7" target="t:保存" id="e1217"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:変換可能"><data key="node_type">term_candidate</data><data key="display">変換可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.9.2:C7" target="t:変換可能" id="e1218"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未決定"><data key="node_type">term_candidate</data><data key="display">未決定</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.9.2:C7" target="t:未決定" id="e1219"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9.2:C7" target="t:残差" id="e1220"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9.2:C7" target="f:である" id="e1221"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.9.3:C7"><data key="node_type">sentence</data><data key="display">通約とは、差異を消すことではなく、照合可能な境界面を作ることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L479:C7</data><data key="split">test</data></node><edge source="s:SAT:12.9.3:C7" target="t:通約" id="e1222"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9.3:C7" target="t:差異" id="e1223"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9.3:C7" target="t:照合可能" id="e1224"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:境界面"><data key="node_type">term_candidate</data><data key="display">境界面</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.9.3:C7" target="t:境界面" id="e1225"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.9.3:C7" target="f:とは" id="e1226"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:12.9.3:C7" target="f:である" id="e1227"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.10:C6"><data key="node_type">sentence</data><data key="display">言語ゲームの失敗は、残差を非常識・非合理・非存在として処分し、照合可能性を失わせることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L481:C6</data><data key="split">tune</data></node><edge source="s:SAT:12.10:C6" target="t:言語" id="e1228"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10:C6" target="t:ゲーム" id="e1229"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10:C6" target="t:失敗" id="e1230"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10:C6" target="t:残差" id="e1231"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:非常識"><data key="node_type">term_candidate</data><data key="display">非常識</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10:C6" target="t:非常識" id="e1232"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:非合理"><data key="node_type">term_candidate</data><data key="display">非合理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10:C6" target="t:非合理" id="e1233"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:非存在"><data key="node_type">term_candidate</data><data key="display">非存在</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10:C6" target="t:非存在" id="e1234"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:処分"><data key="node_type">term_candidate</data><data key="display">処分</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10:C6" target="t:処分" id="e1235"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:照合可能性"><data key="node_type">term_candidate</data><data key="display">照合可能性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10:C6" target="t:照合可能性" id="e1236"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10:C6" target="f:として" id="e1237"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:12.10:C6" target="f:である" id="e1238"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:12.10.1:C8"><data key="node_type">sentence</data><data key="display">残差をユーモアとして処理する、または誤解や誤謬として扱う場合には、照合の可能性が残される。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L483:C8</data><data key="split">test</data></node><edge source="s:SAT:12.10.1:C8" target="t:残差" id="e1239"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:ユーモア"><data key="node_type">term_candidate</data><data key="display">ユーモア</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10.1:C8" target="t:ユーモア" id="e1240"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10.1:C8" target="t:処理" id="e1241"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10.1:C8" target="t:誤解" id="e1242"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:誤謬"><data key="node_type">term_candidate</data><data key="display">誤謬</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10.1:C8" target="t:誤謬" id="e1243"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10.1:C8" target="t:場合" id="e1244"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10.1:C8" target="t:照合" id="e1245"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:可能性"><data key="node_type">term_candidate</data><data key="display">可能性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10.1:C8" target="t:可能性" id="e1246"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:12.10.1:C8" target="f:として" id="e1247"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="f:場合に"><data key="node_type">expression_candidate</data><data key="display">場合に</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:12.10.1:C8" target="f:場合に" id="e1248"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.1:C5"><data key="node_type">sentence</data><data key="display">AIは、外部記憶を高速化する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L489:C5</data><data key="split">register</data></node><edge source="s:SAT:13.1:C5" target="t:AI" id="e1249"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.1:C5" target="t:外部記憶" id="e1250"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:高速化"><data key="node_type">term_candidate</data><data key="display">高速化</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.1:C5" target="t:高速化" id="e1251"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:13.2:C5"><data key="node_type">sentence</data><data key="display">AIは、候補を増やす。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L491:C5</data><data key="split">register</data></node><edge source="s:SAT:13.2:C5" target="t:AI" id="e1252"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:候補"><data key="node_type">term_candidate</data><data key="display">候補</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.2:C5" target="t:候補" id="e1253"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:13.3:C5"><data key="node_type">sentence</data><data key="display">AIは、要約し、分類し、比較し、生成する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L493:C5</data><data key="split">register</data></node><edge source="s:SAT:13.3:C5" target="t:AI" id="e1254"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:要約"><data key="node_type">term_candidate</data><data key="display">要約</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.3:C5" target="t:要約" id="e1255"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.3:C5" target="t:分類" id="e1256"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.3:C5" target="t:比較" id="e1257"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:生成"><data key="node_type">term_candidate</data><data key="display">生成</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.3:C5" target="t:生成" id="e1258"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:13.4:C5"><data key="node_type">sentence</data><data key="display">AIは、内部理解そのものではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L495:C5</data><data key="split">register</data></node><edge source="s:SAT:13.4:C5" target="t:AI" id="e1259"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.4:C5" target="t:内部理解" id="e1260"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.4:C5" target="f:ではない" id="e1261"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.5:C5"><data key="node_type">sentence</data><data key="display">AIは、外部ヒューリスティックの増幅装置である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L497:C5</data><data key="split">test</data></node><edge source="s:SAT:13.5:C5" target="t:AI" id="e1262"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.5:C5" target="t:外部" id="e1263"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.5:C5" target="t:ヒューリスティック" id="e1264"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:増幅装置"><data key="node_type">term_candidate</data><data key="display">増幅装置</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.5:C5" target="t:増幅装置" id="e1265"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.5:C5" target="f:である" id="e1266"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.6:C5"><data key="node_type">sentence</data><data key="display">AIを内部理解の代替にすると、判断主体は痩せる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L499:C5</data><data key="split">register</data></node><edge source="s:SAT:13.6:C5" target="t:AI" id="e1267"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.6:C5" target="t:内部理解" id="e1268"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:代替"><data key="node_type">term_candidate</data><data key="display">代替</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.6:C5" target="t:代替" id="e1269"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:判断主体"><data key="node_type">term_candidate</data><data key="display">判断主体</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.6:C5" target="t:判断主体" id="e1270"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:13.7:C5"><data key="node_type">sentence</data><data key="display">AIを外部ヒューリスティックとして使い、内部理解と照合するなら、判断可能性は増える。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L501:C5</data><data key="split">register</data></node><edge source="s:SAT:13.7:C5" target="t:AI" id="e1271"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.7:C5" target="t:外部" id="e1272"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.7:C5" target="t:ヒューリスティック" id="e1273"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.7:C5" target="t:内部理解" id="e1274"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.7:C5" target="t:照合" id="e1275"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.7:C5" target="t:判断可能性" id="e1276"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.7:C5" target="f:として" id="e1277"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:13.7:C5" target="f:照合する" id="e1278"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.8:C5"><data key="node_type">sentence</data><data key="display">AIの危険は、間違えることだけではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L503:C5</data><data key="split">register</data></node><edge source="s:SAT:13.8:C5" target="t:AI" id="e1279"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.8:C5" target="t:危険" id="e1280"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:間違"><data key="node_type">term_candidate</data><data key="display">間違</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.8:C5" target="t:間違" id="e1281"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.8:C5" target="f:ではない" id="e1282"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.8.1:C7"><data key="node_type">sentence</data><data key="display">AIの危険は、未解決を閉じたように見せることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L505:C7</data><data key="split">register</data></node><edge source="s:SAT:13.8.1:C7" target="t:AI" id="e1283"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.8.1:C7" target="t:危険" id="e1284"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.8.1:C7" target="t:未解決" id="e1285"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.8.1:C7" target="f:である" id="e1286"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.9:C5"><data key="node_type">sentence</data><data key="display">AIの有用性は、答えを出すことだけではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L507:C5</data><data key="split">register</data></node><edge source="s:SAT:13.9:C5" target="t:AI" id="e1287"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:有用性"><data key="node_type">term_candidate</data><data key="display">有用性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.9:C5" target="t:有用性" id="e1288"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.9:C5" target="f:ではない" id="e1289"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.9.1:C7"><data key="node_type">sentence</data><data key="display">AIの有用性は、判断可能性を保つことである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L509:C7</data><data key="split">tune</data></node><edge source="s:SAT:13.9.1:C7" target="t:AI" id="e1290"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.9.1:C7" target="t:有用性" id="e1291"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.9.1:C7" target="t:判断可能性" id="e1292"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.9.1:C7" target="f:である" id="e1293"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.10:C6"><data key="node_type">sentence</data><data key="display">AI時代の批判哲学は、AIを拒絶することではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L511:C6</data><data key="split">register</data></node><edge source="s:SAT:13.10:C6" target="t:AI" id="e1294"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10:C6" target="t:時代" id="e1295"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:批判哲学"><data key="node_type">term_candidate</data><data key="display">批判哲学</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.10:C6" target="t:批判哲学" id="e1296"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:拒絶"><data key="node_type">term_candidate</data><data key="display">拒絶</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.10:C6" target="t:拒絶" id="e1297"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10:C6" target="f:ではない" id="e1298"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.10.1:C8"><data key="node_type">sentence</data><data key="display">AI時代の批判哲学は、AIによって増幅された外部ヒューリスティックを、内部理解とどう同期し、どう照合するかを問うことである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L513:C8</data><data key="split">register</data></node><edge source="s:SAT:13.10.1:C8" target="t:AI" id="e1299"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="t:時代" id="e1300"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="t:批判哲学" id="e1301"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:増幅"><data key="node_type">term_candidate</data><data key="display">増幅</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.10.1:C8" target="t:増幅" id="e1302"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="t:外部" id="e1303"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="t:ヒューリスティック" id="e1304"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="t:内部理解" id="e1305"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="t:同期" id="e1306"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="t:照合" id="e1307"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="f:によって" id="e1308"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="f:照合する" id="e1309"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="f:問う" id="e1310"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:13.10.1:C8" target="f:である" id="e1311"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.11:C6"><data key="node_type">sentence</data><data key="display">AIは、残差を保持する補助にもなりうる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L515:C6</data><data key="split">register</data></node><edge source="s:SAT:13.11:C6" target="t:AI" id="e1312"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11:C6" target="t:残差" id="e1313"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11:C6" target="t:保持" id="e1314"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:補助"><data key="node_type">term_candidate</data><data key="display">補助</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.11:C6" target="t:補助" id="e1315"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11:C6" target="f:保持する" id="e1316"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:13.11.1:C8"><data key="node_type">sentence</data><data key="display">AIは、残差を偽閉鎖する装置にもなりうる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L517:C8</data><data key="split">test</data></node><edge source="s:SAT:13.11.1:C8" target="t:AI" id="e1317"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11.1:C8" target="t:残差" id="e1318"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11.1:C8" target="t:偽閉鎖" id="e1319"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:装置"><data key="node_type">term_candidate</data><data key="display">装置</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:13.11.1:C8" target="t:装置" id="e1320"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:13.11.2:C8"><data key="node_type">sentence</data><data key="display">有用なAIは、残差を消すAIではなく、残差へのアクセス経路を保つAIである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L519:C8</data><data key="split">tune</data></node><edge source="s:SAT:13.11.2:C8" target="t:有用" id="e1321"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11.2:C8" target="t:AI" id="e1322"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11.2:C8" target="t:残差" id="e1323"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11.2:C8" target="t:アクセス" id="e1324"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11.2:C8" target="t:経路" id="e1325"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:13.11.2:C8" target="f:である" id="e1326"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.1:C5"><data key="node_type">sentence</data><data key="display">知は暴走する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L525:C5</data><data key="split">register</data></node><edge source="s:SAT:14.1:C5" target="t:知" id="e1327"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.1:C5" target="t:暴走" id="e1328"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.2:C5"><data key="node_type">sentence</data><data key="display">感性は、受け取れるものだけを世界と誤認する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L527:C5</data><data key="split">tune</data></node><edge source="s:SAT:14.2:C5" target="t:感性" id="e1329"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.2:C5" target="t:世界" id="e1330"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.2:C5" target="t:誤認" id="e1331"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.3:C5"><data key="node_type">sentence</data><data key="display">悟性は、分類できるものだけを対象と誤認する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L529:C5</data><data key="split">register</data></node><edge source="s:SAT:14.3:C5" target="t:悟性" id="e1332"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.3:C5" target="t:分類" id="e1333"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.3:C5" target="t:対象" id="e1334"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.3:C5" target="t:誤認" id="e1335"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.4:C5"><data key="node_type">sentence</data><data key="display">理性は、閉じられるものだけを真理と誤認する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L531:C5</data><data key="split">register</data></node><edge source="s:SAT:14.4:C5" target="t:理性" id="e1336"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:真理"><data key="node_type">term_candidate</data><data key="display">真理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.4:C5" target="t:真理" id="e1337"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.4:C5" target="t:誤認" id="e1338"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.5:C5"><data key="node_type">sentence</data><data key="display">科学は、測定可能なものだけを現実と誤認することがある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L533:C5</data><data key="split">register</data></node><edge source="s:SAT:14.5:C5" target="t:科学" id="e1339"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:測定可能"><data key="node_type">term_candidate</data><data key="display">測定可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.5:C5" target="t:測定可能" id="e1340"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:現実"><data key="node_type">term_candidate</data><data key="display">現実</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.5:C5" target="t:現実" id="e1341"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.5:C5" target="t:誤認" id="e1342"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.6:C5"><data key="node_type">sentence</data><data key="display">制度は、記録可能なものだけを責任と誤認することがある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L535:C5</data><data key="split">test</data></node><edge source="s:SAT:14.6:C5" target="t:制度" id="e1343"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:記録可能"><data key="node_type">term_candidate</data><data key="display">記録可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.6:C5" target="t:記録可能" id="e1344"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.6:C5" target="t:責任" id="e1345"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.6:C5" target="t:誤認" id="e1346"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.7:C5"><data key="node_type">sentence</data><data key="display">経済は、価格化可能なものだけを価値と誤認することがある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L537:C5</data><data key="split">register</data></node><node id="t:経済"><data key="node_type">term_candidate</data><data key="display">経済</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.7:C5" target="t:経済" id="e1347"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:価格化可能"><data key="node_type">term_candidate</data><data key="display">価格化可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.7:C5" target="t:価格化可能" id="e1348"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.7:C5" target="t:価値" id="e1349"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.7:C5" target="t:誤認" id="e1350"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.8:C5"><data key="node_type">sentence</data><data key="display">AIは、出力可能なものだけを回答と誤認することがある。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L539:C5</data><data key="split">register</data></node><edge source="s:SAT:14.8:C5" target="t:AI" id="e1351"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:出力可能"><data key="node_type">term_candidate</data><data key="display">出力可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.8:C5" target="t:出力可能" id="e1352"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:回答"><data key="node_type">term_candidate</data><data key="display">回答</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.8:C5" target="t:回答" id="e1353"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.8:C5" target="t:誤認" id="e1354"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.9:C5"><data key="node_type">sentence</data><data key="display">これらはすべて、境界の失敗である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L541:C5</data><data key="split">register</data></node><edge source="s:SAT:14.9:C5" target="t:境界" id="e1355"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.9:C5" target="t:失敗" id="e1356"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.9:C5" target="f:である" id="e1357"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.10:C6"><data key="node_type">sentence</data><data key="display">境界認識批判は、何を受け取り、何を分類し、何を閉じ、何を残差として保持するかを問う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L543:C6</data><data key="split">test</data></node><edge source="s:SAT:14.10:C6" target="t:境界認識批判" id="e1358"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.10:C6" target="t:分類" id="e1359"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.10:C6" target="t:残差" id="e1360"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.10:C6" target="t:保持" id="e1361"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.10:C6" target="f:として" id="e1362"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:14.10:C6" target="f:保持する" id="e1363"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:14.10:C6" target="f:問う" id="e1364"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.11:C6"><data key="node_type">sentence</data><data key="display">境界認識批判は、知を弱めるためのものではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L545:C6</data><data key="split">test</data></node><edge source="s:SAT:14.11:C6" target="t:境界認識批判" id="e1365"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.11:C6" target="t:知" id="e1366"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.11:C6" target="f:ではない" id="e1367"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.12:C6"><data key="node_type">sentence</data><data key="display">境界認識批判は、知が正当に働く条件を固定するためのものである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L547:C6</data><data key="split">register</data></node><edge source="s:SAT:14.12:C6" target="t:境界認識批判" id="e1368"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.12:C6" target="t:知" id="e1369"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.12:C6" target="t:正当" id="e1370"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.12:C6" target="t:条件" id="e1371"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.12:C6" target="t:固定" id="e1372"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.12:C6" target="f:である" id="e1373"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.13:C6"><data key="node_type">sentence</data><data key="display">同期だけでよいとする態度は、残差を捨てる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L549:C6</data><data key="split">test</data></node><edge source="s:SAT:14.13:C6" target="t:同期" id="e1374"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:態度"><data key="node_type">term_candidate</data><data key="display">態度</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.13:C6" target="t:態度" id="e1375"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.13:C6" target="t:残差" id="e1376"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.13:C6" target="f:とする" id="e1377"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.14:C6"><data key="node_type">sentence</data><data key="display">照合だけを絶対化する態度は、残差を無理に閉じる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L551:C6</data><data key="split">test</data></node><edge source="s:SAT:14.14:C6" target="t:照合" id="e1378"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.14:C6" target="t:絶対化" id="e1379"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.14:C6" target="t:態度" id="e1380"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.14:C6" target="t:残差" id="e1381"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.14:C6" target="t:無理" id="e1382"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.15:C6"><data key="node_type">sentence</data><data key="display">同期も照合も捨てる態度は、残差を氾濫させる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L553:C6</data><data key="split">register</data></node><edge source="s:SAT:14.15:C6" target="t:同期" id="e1383"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.15:C6" target="t:照合" id="e1384"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.15:C6" target="t:態度" id="e1385"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.15:C6" target="t:残差" id="e1386"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.15:C6" target="t:氾濫" id="e1387"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.16:C6"><data key="node_type">sentence</data><data key="display">履歴と切れたカオスは、残差が接続先を失った状態である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L555:C6</data><data key="split">test</data></node><edge source="s:SAT:14.16:C6" target="t:履歴" id="e1388"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.16:C6" target="t:カオス" id="e1389"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.16:C6" target="t:残差" id="e1390"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:接続先"><data key="node_type">term_candidate</data><data key="display">接続先</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.16:C6" target="t:接続先" id="e1391"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.16:C6" target="t:状態" id="e1392"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.16:C6" target="f:である" id="e1393"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.17:C6"><data key="node_type">sentence</data><data key="display">したがって、知の暴走条件は、残差処理の失敗として再記述できる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L557:C6</data><data key="split">register</data></node><edge source="s:SAT:14.17:C6" target="t:知" id="e1394"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:暴走条件"><data key="node_type">term_candidate</data><data key="display">暴走条件</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.17:C6" target="t:暴走条件" id="e1395"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:残差処理"><data key="node_type">term_candidate</data><data key="display">残差処理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.17:C6" target="t:残差処理" id="e1396"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.17:C6" target="t:失敗" id="e1397"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:再記述"><data key="node_type">term_candidate</data><data key="display">再記述</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.17:C6" target="t:再記述" id="e1398"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.17:C6" target="f:したがって" id="e1399"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:14.17:C6" target="f:として" id="e1400"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.18:C6"><data key="node_type">sentence</data><data key="display">事実は、条件と出典のもとで、現在の記述を強く拘束する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L559:C6</data><data key="split">register</data></node><edge source="s:SAT:14.18:C6" target="t:事実" id="e1401"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.18:C6" target="t:条件" id="e1402"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:出典"><data key="node_type">term_candidate</data><data key="display">出典</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.18:C6" target="t:出典" id="e1403"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.18:C6" target="t:現在" id="e1404"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:記述"><data key="node_type">term_candidate</data><data key="display">記述</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.18:C6" target="t:記述" id="e1405"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:拘束"><data key="node_type">term_candidate</data><data key="display">拘束</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.18:C6" target="t:拘束" id="e1406"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:14.18.1:C8"><data key="node_type">sentence</data><data key="display">しかし、事実の集積それ自体は、真実そのものへの到達を意味しない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L561:C8</data><data key="split">register</data></node><edge source="s:SAT:14.18.1:C8" target="t:事実" id="e1407"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:集積"><data key="node_type">term_candidate</data><data key="display">集積</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.18.1:C8" target="t:集積" id="e1408"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:自体"><data key="node_type">term_candidate</data><data key="display">自体</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.18.1:C8" target="t:自体" id="e1409"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:真実"><data key="node_type">term_candidate</data><data key="display">真実</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.18.1:C8" target="t:真実" id="e1410"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.18.1:C8" target="t:到達" id="e1411"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.18.1:C8" target="t:意味" id="e1412"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.18.1:C8" target="f:しかし" id="e1413"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.19:C6"><data key="node_type">sentence</data><data key="display">経験を増やすことは、有限な観測者の解像度を上げうる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L563:C6</data><data key="split">test</data></node><edge source="s:SAT:14.19:C6" target="t:経験" id="e1414"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:有限"><data key="node_type">term_candidate</data><data key="display">有限</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.19:C6" target="t:有限" id="e1415"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:観測者"><data key="node_type">term_candidate</data><data key="display">観測者</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.19:C6" target="t:観測者" id="e1416"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:解像度"><data key="node_type">term_candidate</data><data key="display">解像度</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.19:C6" target="t:解像度" id="e1417"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.19:C6" target="f:とは" id="e1418"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.19.1:C8"><data key="node_type">sentence</data><data key="display">しかし、経験量の増大は、有限な観測者を真実全体の所有者へ変えない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L565:C8</data><data key="split">register</data></node><node id="t:経験量"><data key="node_type">term_candidate</data><data key="display">経験量</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.19.1:C8" target="t:経験量" id="e1419"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:増大"><data key="node_type">term_candidate</data><data key="display">増大</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.19.1:C8" target="t:増大" id="e1420"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.19.1:C8" target="t:有限" id="e1421"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.19.1:C8" target="t:観測者" id="e1422"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:真実全体"><data key="node_type">term_candidate</data><data key="display">真実全体</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.19.1:C8" target="t:真実全体" id="e1423"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:所有者"><data key="node_type">term_candidate</data><data key="display">所有者</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.19.1:C8" target="t:所有者" id="e1424"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.19.1:C8" target="f:しかし" id="e1425"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.20:C6"><data key="node_type">sentence</data><data key="display">現在到達した事実集合を真実全体として閉じるなら、未知の観測軸、将来の反証、別の履歴、残差への返路を閉じる。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L567:C6</data><data key="split">register</data></node><node id="t:現在到達"><data key="node_type">term_candidate</data><data key="display">現在到達</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.20:C6" target="t:現在到達" id="e1426"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:事実集合"><data key="node_type">term_candidate</data><data key="display">事実集合</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.20:C6" target="t:事実集合" id="e1427"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.20:C6" target="t:真実全体" id="e1428"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未知"><data key="node_type">term_candidate</data><data key="display">未知</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.20:C6" target="t:未知" id="e1429"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:観測軸"><data key="node_type">term_candidate</data><data key="display">観測軸</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.20:C6" target="t:観測軸" id="e1430"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:将来"><data key="node_type">term_candidate</data><data key="display">将来</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.20:C6" target="t:将来" id="e1431"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.20:C6" target="t:反証" id="e1432"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.20:C6" target="t:履歴" id="e1433"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.20:C6" target="t:残差" id="e1434"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:返路"><data key="node_type">term_candidate</data><data key="display">返路</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.20:C6" target="t:返路" id="e1435"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.20:C6" target="f:として" id="e1436"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.21:C6"><data key="node_type">sentence</data><data key="display">したがって、知の完成宣言は、最も強い偽閉鎖候補の一つである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L569:C6</data><data key="split">test</data></node><edge source="s:SAT:14.21:C6" target="t:知" id="e1437"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:完成宣言"><data key="node_type">term_candidate</data><data key="display">完成宣言</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.21:C6" target="t:完成宣言" id="e1438"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:偽閉鎖候補"><data key="node_type">term_candidate</data><data key="display">偽閉鎖候補</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.21:C6" target="t:偽閉鎖候補" id="e1439"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.21:C6" target="f:したがって" id="e1440"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:14.21:C6" target="f:である" id="e1441"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:14.22:C6"><data key="node_type">sentence</data><data key="display">著者の表現で言えば、**「完成するなら、そのとき私は地上の神となっているだろう。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L571:C6</data><data key="split">tune</data></node><node id="t:著者"><data key="node_type">term_candidate</data><data key="display">著者</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.22:C6" target="t:著者" id="e1442"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:表現"><data key="node_type">term_candidate</data><data key="display">表現</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.22:C6" target="t:表現" id="e1443"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:完成"><data key="node_type">term_candidate</data><data key="display">完成</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.22:C6" target="t:完成" id="e1444"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:地上"><data key="node_type">term_candidate</data><data key="display">地上</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:14.22:C6" target="t:地上" id="e1445"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:14.22:C6" target="f:とき" id="e1446"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.1:C5"><data key="node_type">sentence</data><data key="display">知は、内部と外部のどちらか一方だけでは成立しない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L577:C5</data><data key="split">register</data></node><edge source="s:SAT:15.1:C5" target="t:知" id="e1447"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1:C5" target="t:内部" id="e1448"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1:C5" target="t:外部" id="e1449"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:一方"><data key="node_type">term_candidate</data><data key="display">一方</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:15.1:C5" target="t:一方" id="e1450"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1:C5" target="t:成立" id="e1451"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:一方"><data key="node_type">expression_candidate</data><data key="display">一方</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:15.1:C5" target="f:一方" id="e1452"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.1.1:C7"><data key="node_type">sentence</data><data key="display">知は、内部ヒューリスティックと外部ヒューリスティックの同期によって機能する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L579:C7</data><data key="split">register</data></node><edge source="s:SAT:15.1.1:C7" target="t:知" id="e1453"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1.1:C7" target="t:内部" id="e1454"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1.1:C7" target="t:ヒューリスティック" id="e1455"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1.1:C7" target="t:外部" id="e1456"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1.1:C7" target="t:同期" id="e1457"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1.1:C7" target="t:機能" id="e1458"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.1.1:C7" target="f:によって" id="e1459"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.2:C5"><data key="node_type">sentence</data><data key="display">知は、その同期の一致・不一致・残差を照合することで意味を持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L581:C5</data><data key="split">tune</data></node><edge source="s:SAT:15.2:C5" target="t:知" id="e1460"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.2:C5" target="t:同期" id="e1461"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.2:C5" target="t:一致" id="e1462"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.2:C5" target="t:不一致" id="e1463"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.2:C5" target="t:残差" id="e1464"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.2:C5" target="t:照合" id="e1465"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.2:C5" target="t:意味" id="e1466"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.2:C5" target="f:照合する" id="e1467"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.3:C5"><data key="node_type">sentence</data><data key="display">知は、残差を保持し、再照合可能性を維持することで更新可能性を持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L583:C5</data><data key="split">register</data></node><edge source="s:SAT:15.3:C5" target="t:知" id="e1468"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.3:C5" target="t:残差" id="e1469"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.3:C5" target="t:保持" id="e1470"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.3:C5" target="t:再照合可能性" id="e1471"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.3:C5" target="t:維持" id="e1472"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.3:C5" target="t:更新可能性" id="e1473"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:15.4:C5"><data key="node_type">sentence</data><data key="display">経験は、境界で構成される。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L585:C5</data><data key="split">register</data></node><edge source="s:SAT:15.4:C5" target="t:経験" id="e1474"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.4:C5" target="t:境界" id="e1475"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.4:C5" target="t:構成" id="e1476"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:15.5:C5"><data key="node_type">sentence</data><data key="display">感性と悟性は、履歴場の受容・分類ヒューリスティックである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L587:C5</data><data key="split">register</data></node><edge source="s:SAT:15.5:C5" target="t:感性" id="e1477"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.5:C5" target="t:悟性" id="e1478"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.5:C5" target="t:履歴場" id="e1479"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.5:C5" target="t:受容" id="e1480"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.5:C5" target="t:分類" id="e1481"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.5:C5" target="t:ヒューリスティック" id="e1482"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.5:C5" target="f:である" id="e1483"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.6:C5"><data key="node_type">sentence</data><data key="display">感性と悟性の詳細研究は、形式空間論・時間論・境界ノイズ論として展開される。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L589:C5</data><data key="split">register</data></node><edge source="s:SAT:15.6:C5" target="t:感性" id="e1484"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.6:C5" target="t:悟性" id="e1485"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:詳細研究"><data key="node_type">term_candidate</data><data key="display">詳細研究</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:15.6:C5" target="t:詳細研究" id="e1486"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.6:C5" target="t:形式空間論" id="e1487"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.6:C5" target="t:時間論" id="e1488"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.6:C5" target="t:境界" id="e1489"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.6:C5" target="t:ノイズ" id="e1490"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:展開"><data key="node_type">term_candidate</data><data key="display">展開</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:15.6:C5" target="t:展開" id="e1491"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.6:C5" target="f:として" id="e1492"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.7:C5"><data key="node_type">sentence</data><data key="display">法則は、外部同期可能な高安定ヒューリスティックである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L591:C5</data><data key="split">register</data></node><edge source="s:SAT:15.7:C5" target="t:法則" id="e1493"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.7:C5" target="t:外部同期可能" id="e1494"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.7:C5" target="t:高安定" id="e1495"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.7:C5" target="t:ヒューリスティック" id="e1496"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.7:C5" target="f:である" id="e1497"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.8:C5"><data key="node_type">sentence</data><data key="display">真偽命題は、意味論を持つ。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L593:C5</data><data key="split">tune</data></node><edge source="s:SAT:15.8:C5" target="t:真偽命題" id="e1498"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.8:C5" target="t:意味論" id="e1499"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:15.9:C5"><data key="node_type">sentence</data><data key="display">学問は、同期と照合を再照合可能な形へ保存する営みである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L595:C5</data><data key="split">register</data></node><edge source="s:SAT:15.9:C5" target="t:学問" id="e1500"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.9:C5" target="t:同期" id="e1501"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.9:C5" target="t:照合" id="e1502"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.9:C5" target="t:再照合可能" id="e1503"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.9:C5" target="t:保存" id="e1504"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.9:C5" target="f:である" id="e1505"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.10:C6"><data key="node_type">sentence</data><data key="display">言語ゲームは、共同体における照合規則である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L597:C6</data><data key="split">tune</data></node><edge source="s:SAT:15.10:C6" target="t:言語" id="e1506"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.10:C6" target="t:ゲーム" id="e1507"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:共同体"><data key="node_type">term_candidate</data><data key="display">共同体</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:15.10:C6" target="t:共同体" id="e1508"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.10:C6" target="t:照合規則" id="e1509"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.10:C6" target="f:である" id="e1510"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.11:C6"><data key="node_type">sentence</data><data key="display">AIは、外部ヒューリスティックを増幅する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L599:C6</data><data key="split">register</data></node><edge source="s:SAT:15.11:C6" target="t:AI" id="e1511"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.11:C6" target="t:外部" id="e1512"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.11:C6" target="t:ヒューリスティック" id="e1513"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.11:C6" target="t:増幅" id="e1514"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:15.11.1:C8"><data key="node_type">sentence</data><data key="display">したがって、AI時代には、境界認識批判が必要である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L601:C8</data><data key="split">register</data></node><edge source="s:SAT:15.11.1:C8" target="t:AI" id="e1515"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.11.1:C8" target="t:時代" id="e1516"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.11.1:C8" target="t:境界認識批判" id="e1517"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.11.1:C8" target="t:必要" id="e1518"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.11.1:C8" target="f:したがって" id="e1519"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:15.11.1:C8" target="f:必要である" id="e1520"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.12:C6"><data key="node_type">sentence</data><data key="display">知るとは、世界を所有することではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L603:C6</data><data key="split">register</data></node><edge source="s:SAT:15.12:C6" target="t:知" id="e1521"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12:C6" target="t:世界" id="e1522"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:所有"><data key="node_type">term_candidate</data><data key="display">所有</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:15.12:C6" target="t:所有" id="e1523"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12:C6" target="f:とは" id="e1524"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:15.12:C6" target="f:ではない" id="e1525"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.12.1:C8"><data key="node_type">sentence</data><data key="display">知るとは、境界で接触し、同期し、照合し、残差を保持しながら、次の判断可能性を開くことである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L605:C8</data><data key="split">register</data></node><edge source="s:SAT:15.12.1:C8" target="t:知" id="e1526"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="t:境界" id="e1527"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="t:接触" id="e1528"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="t:同期" id="e1529"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="t:照合" id="e1530"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="t:残差" id="e1531"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="t:保持" id="e1532"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="t:判断可能性" id="e1533"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="f:とは" id="e1534"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="f:しながら" id="e1535"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:15.12.1:C8" target="f:である" id="e1536"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:15.13:C6"><data key="node_type">sentence</data><data key="display">有限な観測者にとって、現在の到達は完成ではなく、再照合可能な仮閉鎖である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L607:C6</data><data key="split">register</data></node><edge source="s:SAT:15.13:C6" target="t:有限" id="e1537"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.13:C6" target="t:観測者" id="e1538"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.13:C6" target="t:現在" id="e1539"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.13:C6" target="t:到達" id="e1540"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.13:C6" target="t:完成" id="e1541"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.13:C6" target="t:再照合可能" id="e1542"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:仮閉鎖"><data key="node_type">term_candidate</data><data key="display">仮閉鎖</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:15.13:C6" target="t:仮閉鎖" id="e1543"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:15.13:C6" target="f:である" id="e1544"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L613:C0"><data key="node_type">sentence</data><data key="display">A.1　本稿は哲学史の総合ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L613:C0</data><data key="split">register</data></node><edge source="s:SAT:L613:C0" target="t:本稿" id="e1545"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L613:C0" target="t:哲学史" id="e1546"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L613:C0" target="t:総合" id="e1547"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L613:C0" target="f:ではない" id="e1548"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L615:C0"><data key="node_type">sentence</data><data key="display">A.2　本稿は、知の成立条件を、境界・履歴・同期・照合・残差保持から再定義する試みである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L615:C0</data><data key="split">register</data></node><edge source="s:SAT:L615:C0" target="t:本稿" id="e1549"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="t:知" id="e1550"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="t:成立条件" id="e1551"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="t:境界" id="e1552"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="t:履歴" id="e1553"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="t:同期" id="e1554"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="t:照合" id="e1555"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="t:残差保持" id="e1556"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="t:再定義" id="e1557"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L615:C0" target="f:である" id="e1558"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L617:C0"><data key="node_type">sentence</data><data key="display">A.3　既存思想との接続は、本稿の権威づけではなく、未踏領域を主張しないための照合である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L617:C0</data><data key="split">register</data></node><edge source="s:SAT:L617:C0" target="t:既存思想" id="e1559"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L617:C0" target="t:接続" id="e1560"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L617:C0" target="t:本稿" id="e1561"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L617:C0" target="t:権威" id="e1562"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:未踏領域"><data key="node_type">term_candidate</data><data key="display">未踏領域</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L617:C0" target="t:未踏領域" id="e1563"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:主張"><data key="node_type">term_candidate</data><data key="display">主張</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L617:C0" target="t:主張" id="e1564"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L617:C0" target="t:照合" id="e1565"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L617:C0" target="f:である" id="e1566"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L619:C0"><data key="node_type">sentence</data><data key="display">A.4　オッカム、ヒューム、カント、スピノザ、シェリング、ヘーゲル、ゲーデル、フッサール、ソシュール、ウィトゲンシュタイン、エーコ、ポパー、クワイン、クーン、ジェームズ、パース、デューイ、ユング、メルロ＝ポンティなどは、本文の命題列に対する注解として扱う。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L619:C0</data><data key="split">register</data></node><node id="t:オッカム"><data key="node_type">term_candidate</data><data key="display">オッカム</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L619:C0" target="t:オッカム" id="e1567"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:ヒューム"><data key="node_type">term_candidate</data><data key="display">ヒューム</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L619:C0" target="t:ヒューム" id="e1568"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:カント"><data key="node_type">term_candidate</data><data key="display">カント</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L619:C0" target="t:カント" id="e1569"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:スピノザ"><data key="node_type">term_candidate</data><data key="display">スピノザ</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L619:C0" target="t:スピノザ" id="e1570"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:シェリング"><data key="node_type">term_candidate</data><data key="display">シェリング</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L619:C0" target="t:シェリング" id="e1571"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:ヘーゲル"><data key="node_type">term_candidate</data><data key="display">ヘーゲル</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L619:C0" target="t:ヘーゲル" id="e1572"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:ゲーデル">