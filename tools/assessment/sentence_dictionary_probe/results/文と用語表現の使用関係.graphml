><data key="split">register</data></node><edge source="s:SAT:L718:C34" target="t:AI" id="e1855"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L718:C34" target="t:理性" id="e1856"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L718:C34" target="t:制度" id="e1857"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L718:C34" target="t:言語" id="e1858"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L718:C34" target="t:ゲーム" id="e1859"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:適用可能"><data key="node_type">term_candidate</data><data key="display">適用可能</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L718:C34" target="t:適用可能" id="e1860"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:中核語"><data key="node_type">term_candidate</data><data key="display">中核語</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L718:C34" target="t:中核語" id="e1861"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L718:C34" target="f:である" id="e1862"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L724:C0"><data key="node_type">sentence</data><data key="display">定義語: **semantic pressure**</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L724:C0</data><data key="split">register</data></node><edge source="s:SAT:L724:C0" target="t:定義語" id="e1863"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L724:C0" target="t:semantic" id="e1864"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:pressure"><data key="node_type">term_candidate</data><data key="display">pressure</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L724:C0" target="t:pressure" id="e1865"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L725:C0"><data key="node_type">sentence</data><data key="display">説明句: **meaning pressure**</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L725:C0</data><data key="split">register</data></node><edge source="s:SAT:L725:C0" target="t:説明句" id="e1866"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:meaning"><data key="node_type">term_candidate</data><data key="display">meaning</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L725:C0" target="t:meaning" id="e1867"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L725:C0" target="t:pressure" id="e1868"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L727:C0"><data key="node_type">sentence</data><data key="display">注意: `semantic pressure` がよい。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L727:C0</data><data key="split">register</data></node><edge source="s:SAT:L727:C0" target="t:注意" id="e1869"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L727:C0" target="t:semantic" id="e1870"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L727:C0" target="t:pressure" id="e1871"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L727:C28"><data key="node_type">sentence</data><data key="display">物理的な圧力ではないことを明記する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L727:C28</data><data key="split">register</data></node><edge source="s:SAT:L727:C28" target="t:物理的" id="e1872"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:圧力"><data key="node_type">term_candidate</data><data key="display">圧力</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L727:C28" target="t:圧力" id="e1873"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L727:C28" target="t:明記" id="e1874"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L727:C28" target="f:ではない" id="e1875"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L729:C0"><data key="node_type">sentence</data><data key="display">補足: 意味圧とは、未閉鎖の gap や残差が、既存の closure に似た構造を要求し、解釈・分類・補完・再照合を促す圧である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L729:C0</data><data key="split">tune</data></node><edge source="s:SAT:L729:C0" target="t:補足" id="e1876"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:意味圧" id="e1877"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:未閉鎖" id="e1878"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:gap" id="e1879"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:残差" id="e1880"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:既存" id="e1881"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:closure" id="e1882"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:構造" id="e1883"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:要求" id="e1884"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:解釈" id="e1885"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:分類" id="e1886"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:補完" id="e1887"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="t:再照合" id="e1888"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="f:とは" id="e1889"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:L729:C0" target="f:である" id="e1890"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L729:C66"><data key="node_type">sentence</data><data key="display">history-field を無視してこの圧を処理すると、false closure が発生しやすい。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L729:C66</data><data key="split">register</data></node><edge source="s:SAT:L729:C66" target="t:history-field" id="e1891"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C66" target="t:無視" id="e1892"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C66" target="t:処理" id="e1893"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C66" target="t:false" id="e1894"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C66" target="t:closure" id="e1895"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L729:C66" target="t:発生" id="e1896"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L735:C0"><data key="node_type">sentence</data><data key="display">定義語: **logical-depth axis**</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L735:C0</data><data key="split">register</data></node><edge source="s:SAT:L735:C0" target="t:定義語" id="e1897"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:logical-depth"><data key="node_type">term_candidate</data><data key="display">logical-depth</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L735:C0" target="t:logical-depth" id="e1898"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:axis"><data key="node_type">term_candidate</data><data key="display">axis</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L735:C0" target="t:axis" id="e1899"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L736:C0"><data key="node_type">sentence</data><data key="display">補足候補: **logical-depth axis in the SO sense**</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L736:C0</data><data key="split">tune</data></node><node id="t:補足候補"><data key="node_type">term_candidate</data><data key="display">補足候補</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L736:C0" target="t:補足候補" id="e1900"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L736:C0" target="t:logical-depth" id="e1901"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L736:C0" target="t:axis" id="e1902"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:in"><data key="node_type">term_candidate</data><data key="display">in</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L736:C0" target="t:in" id="e1903"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L736:C0" target="t:the" id="e1904"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:SO"><data key="node_type">term_candidate</data><data key="display">SO</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L736:C0" target="t:SO" id="e1905"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:sense"><data key="node_type">term_candidate</data><data key="display">sense</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L736:C0" target="t:sense" id="e1906"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L738:C0"><data key="node_type">sentence</data><data key="display">注意: 計算理論上の `logical depth` との同一視を避ける。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L738:C0</data><data key="split">test</data></node><edge source="s:SAT:L738:C0" target="t:注意" id="e1907"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:計算理論上"><data key="node_type">term_candidate</data><data key="display">計算理論上</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L738:C0" target="t:計算理論上" id="e1908"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:logical"><data key="node_type">term_candidate</data><data key="display">logical</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L738:C0" target="t:logical" id="e1909"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:depth"><data key="node_type">term_candidate</data><data key="display">depth</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L738:C0" target="t:depth" id="e1910"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C0" target="t:同一視" id="e1911"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L738:C37"><data key="node_type">sentence</data><data key="display">SOにおける論理-深度は、未解決・矛盾・分岐・残差・意味圧を保持し、再構成する深度方向である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L738:C37</data><data key="split">register</data></node><edge source="s:SAT:L738:C37" target="t:SO" id="e1912"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:論理" id="e1913"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:深度"><data key="node_type">term_candidate</data><data key="display">深度</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L738:C37" target="t:深度" id="e1914"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:未解決" id="e1915"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:矛盾" id="e1916"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:分岐" id="e1917"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:残差" id="e1918"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:意味圧" id="e1919"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:保持" id="e1920"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:再構成" id="e1921"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="t:深度方向" id="e1922"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L738:C37" target="f:である" id="e1923"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L740:C0"><data key="node_type">sentence</data><data key="display">補足: 必要に応じて、外的時間に対する別方向、すなわち残差・残渣・未閉鎖 gap が蓄積する虚軸的な時間構造として説明する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L740:C0</data><data key="split">register</data></node><edge source="s:SAT:L740:C0" target="t:補足" id="e1924"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="t:必要" id="e1925"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="t:外的時間" id="e1926"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:別方向"><data key="node_type">term_candidate</data><data key="display">別方向</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L740:C0" target="t:別方向" id="e1927"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="t:残差" id="e1928"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="t:残渣" id="e1929"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="t:未閉鎖" id="e1930"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="t:gap" id="e1931"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="t:蓄積" id="e1932"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:虚軸的"><data key="node_type">term_candidate</data><data key="display">虚軸的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L740:C0" target="t:虚軸的" id="e1933"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:時間構造"><data key="node_type">term_candidate</data><data key="display">時間構造</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L740:C0" target="t:時間構造" id="e1934"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="t:説明" id="e1935"><data key="relation">literal_term_use_not_entailment</data></edge><node id="f:すなわち"><data key="node_type">expression_candidate</data><data key="display">すなわち</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L740:C0" target="f:すなわち" id="e1936"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:L740:C0" target="f:として" id="e1937"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L740:C62"><data key="node_type">sentence</data><data key="display">ただし、数理的に虚軸と定義していない段階では、`quasi-temporal depth axis` 程度に留める。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L740:C62</data><data key="split">test</data></node><node id="t:数理的"><data key="node_type">term_candidate</data><data key="display">数理的</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L740:C62" target="t:数理的" id="e1938"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:虚軸"><data key="node_type">term_candidate</data><data key="display">虚軸</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L740:C62" target="t:虚軸" id="e1939"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C62" target="t:定義" id="e1940"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C62" target="t:段階" id="e1941"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:quasi-temporal"><data key="node_type">term_candidate</data><data key="display">quasi-temporal</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L740:C62" target="t:quasi-temporal" id="e1942"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C62" target="t:depth" id="e1943"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C62" target="t:axis" id="e1944"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C62" target="t:程度" id="e1945"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L740:C62" target="f:ただし" id="e1946"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L746:C0"><data key="node_type">sentence</data><data key="display">定義語: **commensuration**</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L746:C0</data><data key="split">tune</data></node><edge source="s:SAT:L746:C0" target="t:定義語" id="e1947"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:commensuration"><data key="node_type">term_candidate</data><data key="display">commensuration</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L746:C0" target="t:commensuration" id="e1948"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L747:C0"><data key="node_type">sentence</data><data key="display">説明句: **construction of a comparable interface / making different frameworks comparable**</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L747:C0</data><data key="split">test</data></node><edge source="s:SAT:L747:C0" target="t:説明句" id="e1949"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:construction"><data key="node_type">term_candidate</data><data key="display">construction</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L747:C0" target="t:construction" id="e1950"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L747:C0" target="t:of" id="e1951"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:comparable"><data key="node_type">term_candidate</data><data key="display">comparable</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L747:C0" target="t:comparable" id="e1952"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:interface"><data key="node_type">term_candidate</data><data key="display">interface</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L747:C0" target="t:interface" id="e1953"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:making"><data key="node_type">term_candidate</data><data key="display">making</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L747:C0" target="t:making" id="e1954"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:different"><data key="node_type">term_candidate</data><data key="display">different</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L747:C0" target="t:different" id="e1955"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:frameworks"><data key="node_type">term_candidate</data><data key="display">frameworks</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L747:C0" target="t:frameworks" id="e1956"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L749:C0"><data key="node_type">sentence</data><data key="display">注意: クーン的な通約可能性の問題と接続する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L749:C0</data><data key="split">register</data></node><edge source="s:SAT:L749:C0" target="t:注意" id="e1957"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C0" target="t:クーン" id="e1958"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:通約可能性"><data key="node_type">term_candidate</data><data key="display">通約可能性</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L749:C0" target="t:通約可能性" id="e1959"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C0" target="t:問題" id="e1960"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C0" target="t:接続" id="e1961"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L749:C23"><data key="node_type">sentence</data><data key="display">ただし、ここでいう通約は完全翻訳ではない。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L749:C23</data><data key="split">register</data></node><edge source="s:SAT:L749:C23" target="t:通約" id="e1962"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C23" target="t:完全翻訳" id="e1963"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C23" target="f:ただし" id="e1964"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:L749:C23" target="f:ではない" id="e1965"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L749:C44"><data key="node_type">sentence</data><data key="display">異なる言語ゲーム、パラダイム、履歴場の間に、照合可能な対応面を作ることである。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L749:C44</data><data key="split">register</data></node><edge source="s:SAT:L749:C44" target="t:言語" id="e1966"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C44" target="t:ゲーム" id="e1967"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:パラダイム"><data key="node_type">term_candidate</data><data key="display">パラダイム</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L749:C44" target="t:パラダイム" id="e1968"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C44" target="t:履歴場" id="e1969"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C44" target="t:照合可能" id="e1970"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C44" target="t:対応面" id="e1971"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L749:C44" target="f:である" id="e1972"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L751:C0"><data key="node_type">sentence</data><data key="display">補足: `bridge` も文脈によって使えるが、橋は接続成功の印象が強い。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L751:C0</data><data key="split">test</data></node><edge source="s:SAT:L751:C0" target="t:補足" id="e1973"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:bridge"><data key="node_type">term_candidate</data><data key="display">bridge</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L751:C0" target="t:bridge" id="e1974"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:文脈"><data key="node_type">term_candidate</data><data key="display">文脈</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L751:C0" target="t:文脈" id="e1975"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:接続成功"><data key="node_type">term_candidate</data><data key="display">接続成功</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L751:C0" target="t:接続成功" id="e1976"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:印象"><data key="node_type">term_candidate</data><data key="display">印象</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L751:C0" target="t:印象" id="e1977"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L751:C0" target="f:によって" id="e1978"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L751:C38"><data key="node_type">sentence</data><data key="display">残差を伴う不完全な接続を強調する場合は `comparable interface` の方がよい。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L751:C38</data><data key="split">tune</data></node><edge source="s:SAT:L751:C38" target="t:残差" id="e1979"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:不完全"><data key="node_type">term_candidate</data><data key="display">不完全</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L751:C38" target="t:不完全" id="e1980"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L751:C38" target="t:接続" id="e1981"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L751:C38" target="t:強調" id="e1982"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L751:C38" target="t:場合" id="e1983"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L751:C38" target="t:comparable" id="e1984"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L751:C38" target="t:interface" id="e1985"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L751:C38" target="f:場合は" id="e1986"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L757:C0"><data key="node_type">sentence</data><data key="display">定義語: **capacity for re-collation**</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L757:C0</data><data key="split">register</data></node><edge source="s:SAT:L757:C0" target="t:定義語" id="e1987"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L757:C0" target="t:capacity" id="e1988"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L757:C0" target="t:for" id="e1989"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:re-collation"><data key="node_type">term_candidate</data><data key="display">re-collation</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L757:C0" target="t:re-collation" id="e1990"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L758:C0"><data key="node_type">sentence</data><data key="display">候補: **re-examinability / capacity for re-examination**</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L758:C0</data><data key="split">tune</data></node><edge source="s:SAT:L758:C0" target="t:候補" id="e1991"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:re-examinability"><data key="node_type">term_candidate</data><data key="display">re-examinability</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L758:C0" target="t:re-examinability" id="e1992"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L758:C0" target="t:capacity" id="e1993"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L758:C0" target="t:for" id="e1994"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:re-examination"><data key="node_type">term_candidate</data><data key="display">re-examination</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L758:C0" target="t:re-examination" id="e1995"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L760:C0"><data key="node_type">sentence</data><data key="display">注意: `re-collation` は体系語としてはよいが硬い。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L760:C0</data><data key="split">register</data></node><edge source="s:SAT:L760:C0" target="t:注意" id="e1996"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C0" target="t:re-collation" id="e1997"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C0" target="t:体系語" id="e1998"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C0" target="f:として" id="e1999"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L760:C33"><data key="node_type">sentence</data><data key="display">意味・判断・学問制度の文脈では `re-examinability` または `capacity for re-examination` を併用する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L760:C33</data><data key="split">tune</data></node><edge source="s:SAT:L760:C33" target="t:意味" id="e2000"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C33" target="t:判断" id="e2001"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:学問制度"><data key="node_type">term_candidate</data><data key="display">学問制度</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L760:C33" target="t:学問制度" id="e2002"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C33" target="t:文脈" id="e2003"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C33" target="t:re-examinability" id="e2004"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C33" target="t:capacity" id="e2005"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C33" target="t:for" id="e2006"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L760:C33" target="t:re-examination" id="e2007"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:併用"><data key="node_type">term_candidate</data><data key="display">併用</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L760:C33" target="t:併用" id="e2008"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L762:C0"><data key="node_type">sentence</data><data key="display">補足: 再照合可能性とは、一度閉じた命題・判断・分類・制度的処理を、残差や残渣へのアクセス経路を保ったまま、再び照合可能にする条件である。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L762:C0</data><data key="split">tune</data></node><edge source="s:SAT:L762:C0" target="t:補足" id="e2009"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:再照合可能性" id="e2010"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:一度閉"><data key="node_type">term_candidate</data><data key="display">一度閉</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L762:C0" target="t:一度閉" id="e2011"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:命題" id="e2012"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:判断" id="e2013"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:分類" id="e2014"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:制度的処理"><data key="node_type">term_candidate</data><data key="display">制度的処理</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L762:C0" target="t:制度的処理" id="e2015"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:残差" id="e2016"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:残渣" id="e2017"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:アクセス" id="e2018"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:経路" id="e2019"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:照合可能" id="e2020"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="t:条件" id="e2021"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="f:とは" id="e2022"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:L762:C0" target="f:である" id="e2023"><data key="relation">literal_expression_use_not_entailment</data></edge><node id="s:SAT:L766:C0"><data key="node_type">sentence</data><data key="display">[英語通約](./Boundary_Epistemological_Critique.en.md)。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L766:C0</data><data key="split">tune</data></node><node id="t:英語通約"><data key="node_type">term_candidate</data><data key="display">英語通約</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L766:C0" target="t:英語通約" id="e2024"><data key="relation">literal_term_use_not_entailment</data></edge><node id="s:SAT:L766:C50"><data key="node_type">sentence</data><data key="display">意味に不一致がある場合は、日本語正本と定義所有文書へ戻って照合する。</data><data key="source_anchor">01_Sat_Truth/Boundary_Epistemological_Critique.ja.md:L766:C50</data><data key="split">register</data></node><edge source="s:SAT:L766:C50" target="t:意味" id="e2025"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L766:C50" target="t:不一致" id="e2026"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L766:C50" target="t:場合" id="e2027"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:日本語正本"><data key="node_type">term_candidate</data><data key="display">日本語正本</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L766:C50" target="t:日本語正本" id="e2028"><data key="relation">literal_term_use_not_entailment</data></edge><node id="t:定義所有文書"><data key="node_type">term_candidate</data><data key="display">定義所有文書</data><data key="source_anchor" /><data key="split" /></node><edge source="s:SAT:L766:C50" target="t:定義所有文書" id="e2029"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L766:C50" target="t:照合" id="e2030"><data key="relation">literal_term_use_not_entailment</data></edge><edge source="s:SAT:L766:C50" target="f:場合は" id="e2031"><data key="relation">literal_expression_use_not_entailment</data></edge><edge source="s:SAT:L766:C50" target="f:照合する" id="e2032"><data key="relation">literal_expression_use_not_entailment</data></edge></graph></graphml>
